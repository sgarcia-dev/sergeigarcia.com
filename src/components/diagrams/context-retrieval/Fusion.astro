<svg viewBox="0 0 560 470" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <!-- Source: worked example with four made-up passages A to D, not a measurement. No bar scale. -->
  <text class="d-t d-sm" x="16" y="22">Merging two rankings by position (k = 20)</text>

  <text class="d-t d-b" x="16" y="58">Words list</text>
  <text class="d-t d-b" x="296" y="58">Meaning list</text>

  <rect class="d-yellow" x="16" y="68" width="248" height="34" />
  <text class="d-t d-t-dark d-mono" x="32" y="91">1  A</text>
  <rect class="d-box" x="16" y="106" width="248" height="34" />
  <text class="d-t d-mono" x="32" y="129">2  B</text>
  <rect class="d-yellow" x="16" y="144" width="248" height="34" />
  <text class="d-t d-t-dark d-mono" x="32" y="167">3  C</text>

  <rect class="d-yellow" x="296" y="68" width="248" height="34" />
  <text class="d-t d-t-dark d-mono" x="312" y="91">1  C</text>
  <rect class="d-yellow" x="296" y="106" width="248" height="34" />
  <text class="d-t d-t-dark d-mono" x="312" y="129">2  A</text>
  <rect class="d-box" x="296" y="144" width="248" height="34" />
  <text class="d-t d-mono" x="312" y="167">3  D</text>

  <text class="d-t d-mono" x="16" y="212">score = 1/(20 + rank) per list, summed</text>

  <text class="d-t d-b" x="16" y="252">Merged order</text>

  <rect class="d-yellow" x="16" y="264" width="528" height="34" />
  <text class="d-t d-t-dark d-b" x="32" y="287">A</text>
  <text class="d-t d-t-dark d-mono" x="72" y="287">1/21 + 1/22</text>
  <text class="d-t d-t-dark d-sm" x="230" y="287">in both lists</text>
  <text class="d-t d-t-dark d-mono d-b" x="528" y="287" text-anchor="end">0.093</text>

  <rect class="d-yellow" x="16" y="302" width="528" height="34" />
  <text class="d-t d-t-dark d-b" x="32" y="325">C</text>
  <text class="d-t d-t-dark d-mono" x="72" y="325">1/23 + 1/21</text>
  <text class="d-t d-t-dark d-sm" x="230" y="325">in both lists</text>
  <text class="d-t d-t-dark d-mono d-b" x="528" y="325" text-anchor="end">0.091</text>

  <rect class="d-box" x="16" y="340" width="528" height="34" />
  <text class="d-t d-b" x="32" y="363">B</text>
  <text class="d-t d-mono" x="72" y="363">1/22</text>
  <text class="d-t d-sm" x="230" y="363">in one list</text>
  <text class="d-t d-mono d-b" x="528" y="363" text-anchor="end">0.045</text>

  <rect class="d-box" x="16" y="378" width="528" height="34" />
  <text class="d-t d-b" x="32" y="401">D</text>
  <text class="d-t d-mono" x="72" y="401">1/23</text>
  <text class="d-t d-sm" x="230" y="401">in one list</text>
  <text class="d-t d-mono d-b" x="528" y="401" text-anchor="end">0.043</text>

  <rect class="d-yellow" x="16" y="430" width="24" height="18" />
  <text class="d-t d-sm" x="50" y="445">A and C are in both lists, so they rise</text>
</svg>
