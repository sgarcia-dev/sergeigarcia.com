<svg viewBox="0 0 560 402" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <!-- Source: own measurement over 28 questions, two routes: rg (open top 3 files) and search (8 results).
       Bar scale: each chart is linear from 0 to its max, full scale = 300px, bars start at x = 190.
       (a) 0..28 files, (b) 0..2 seconds, (c) 0..4 calls. -->

  <!-- (a) Found the answer file, scale 0..28 -->
  <text class="d-t d-b" x="16" y="24">Found the answer file (of 28)</text>
  <text class="d-t d-sm" x="16" y="53">rg, top 3 files</text>
  <rect class="d-box" x="190" y="36" width="32.1" height="24" />
  <text class="d-t d-mono" x="230" y="53">3</text>
  <text class="d-t d-sm" x="16" y="85">Search, 8 results</text>
  <rect class="d-yellow" x="190" y="68" width="192.9" height="24" />
  <text class="d-t d-mono" x="391" y="85">18</text>
  <path class="d-line" d="M190,102 L490,102 M190,102 L190,108 M490,102 L490,108" />
  <text class="d-t d-sm" x="190" y="126" text-anchor="middle">0</text>
  <text class="d-t d-sm" x="490" y="126" text-anchor="middle">28</text>

  <!-- (b) Median time per question, scale 0..2 seconds -->
  <text class="d-t d-b" x="16" y="154">Median time per question (seconds)</text>
  <text class="d-t d-sm" x="16" y="183">rg, top 3 files</text>
  <rect class="d-box" x="190" y="166" width="24" height="24" />
  <text class="d-t d-mono" x="222" y="183">0.16</text>
  <text class="d-t d-sm" x="16" y="215">Search, 8 results</text>
  <rect class="d-yellow" x="190" y="198" width="244.5" height="24" />
  <text class="d-t d-mono" x="442" y="215">1.63</text>
  <path class="d-line" d="M190,232 L490,232 M190,232 L190,238 M490,232 L490,238" />
  <text class="d-t d-sm" x="190" y="256" text-anchor="middle">0</text>
  <text class="d-t d-sm" x="490" y="256" text-anchor="middle">2</text>

  <!-- (c) Tool calls per question, scale 0..4 -->
  <text class="d-t d-b" x="16" y="284">Tool calls per question</text>
  <text class="d-t d-sm" x="16" y="313">rg, top 3 files</text>
  <rect class="d-box" x="190" y="296" width="300" height="24" />
  <text class="d-t d-mono" x="498" y="313">4</text>
  <text class="d-t d-sm" x="16" y="345">Search, 8 results</text>
  <rect class="d-yellow" x="190" y="328" width="150" height="24" />
  <text class="d-t d-mono" x="348" y="345">2</text>
  <path class="d-line" d="M190,362 L490,362 M190,362 L190,368 M490,362 L490,368" />
  <text class="d-t d-sm" x="190" y="386" text-anchor="middle">0</text>
  <text class="d-t d-sm" x="490" y="386" text-anchor="middle">4</text>
</svg>
