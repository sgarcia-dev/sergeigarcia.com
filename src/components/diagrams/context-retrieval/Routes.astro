<svg viewBox="0 0 560 560" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <marker id="arr-routes" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="currentColor" />
    </marker>
  </defs>

  <!-- Routes one to three: plain boxes. Routes four and five: yellow, the part tools/search does. -->
  <rect class="d-box" x="20" y="10" width="520" height="72" />
  <text class="d-t d-b" x="36" y="38">Exact text (rg)</text>
  <text class="d-t d-sm" x="36" y="60">Matches the exact string you typed</text>
  <text class="d-t d-sm" x="36" y="78">Gives every matching line, in every file</text>

  <rect class="d-box" x="20" y="98" width="520" height="72" />
  <text class="d-t d-b" x="36" y="126">Words (BM25)</text>
  <text class="d-t d-sm" x="36" y="148">Matches shared words; rare words count more</text>
  <text class="d-t d-sm" x="36" y="166">Gives ranked passages</text>

  <rect class="d-box" x="20" y="186" width="520" height="72" />
  <text class="d-t d-b" x="36" y="214">Meaning (embeddings)</text>
  <text class="d-t d-sm" x="36" y="236">Each passage becomes a list of numbers</text>
  <text class="d-t d-sm" x="36" y="254">Finds paraphrases that share no words</text>

  <rect class="d-yellow" x="20" y="274" width="520" height="168" />
  <text class="d-t d-t-dark d-b" x="36" y="302">Hybrid: words + meaning</text>
  <text class="d-t d-t-dark d-mono d-sm" x="524" y="302" text-anchor="end">tools/search</text>
  <text class="d-t d-t-dark d-sm" x="36" y="324">Merges both rankings by rank</text>
  <text class="d-t d-t-dark d-sm" x="36" y="342">Gives one list (reciprocal rank fusion)</text>
  <rect class="d-line d-dash" x="36" y="358" width="488" height="68" />
  <text class="d-t d-t-dark d-b" x="280" y="384" text-anchor="middle" opacity="0.7">reranker (not built)</text>
  <text class="d-t d-t-dark d-sm" x="280" y="408" text-anchor="middle" opacity="0.7">optional: re-scores the top results</text>

  <path class="d-line" d="M280,442 L280,468" marker-end="url(#arr-routes)" />

  <rect class="d-yellow" x="20" y="470" width="520" height="80" />
  <text class="d-t d-t-dark d-b" x="36" y="498">Then open the original</text>
  <text class="d-t d-t-dark d-mono d-sm" x="524" y="498" text-anchor="end">the agent</text>
  <text class="d-t d-t-dark d-sm" x="36" y="520">Reads only the cited lines</text>
  <text class="d-t d-t-dark d-sm" x="36" y="538">File hash says if it changed since</text>
</svg>
