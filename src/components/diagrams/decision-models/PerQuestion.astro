<svg viewBox="0 0 420 580" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <!-- One question per call. 10 held-out postings x 10 questions = 100 calls per system. Means per call.
       Cost: Jev $0.000048, Haiku agent $0.0041 (84x). Bar = dollars x 48,780 px ($0.0041 = 200px).
       Seconds: Jev 0.52, Haiku 10.5 (20x). Bar = seconds x 19.05 px (10.5 s = 200px).
       Tokens in: Jev 1,147, Haiku 42,309 (37x). Bar = tokens / 211.5 px (42,309 = 200px).
       Accuracy: Jev 97 of 100, Haiku 98 of 100. Axis 0 to 100%, bar = percent x 2.8 px. -->
  <text class="d-t d-b" x="16" y="28">One question per call</text>
  <text class="d-t d-sm" x="16" y="52">Mean per call. 10 postings, 100 calls each.</text>

  <text class="d-t d-b" x="16" y="92">Cost per call, US dollars</text>
  <text class="d-t d-sm d-b" x="16" y="122">Jev</text>
  <rect class="d-yellow" x="70" y="104" width="2.34" height="24" />
  <text class="d-t d-mono d-b" x="80" y="122">$0.000048</text>
  <text class="d-t d-sm" x="16" y="154">Haiku</text>
  <rect class="d-box" x="70" y="136" width="200" height="24" />
  <text class="d-t d-mono" x="278" y="154">$0.0041<tspan class="d-b" dx="10">84x</tspan></text>
  <path class="d-line" d="M70,100 L70,164" />

  <text class="d-t d-b" x="16" y="200">Seconds per call</text>
  <text class="d-t d-sm d-b" x="16" y="230">Jev</text>
  <rect class="d-yellow" x="70" y="212" width="9.9" height="24" />
  <text class="d-t d-mono d-b" x="88" y="230">0.5 s</text>
  <text class="d-t d-sm" x="16" y="262">Haiku</text>
  <rect class="d-box" x="70" y="244" width="200" height="24" />
  <text class="d-t d-mono" x="278" y="262">10.5 s<tspan class="d-b" dx="10">20x</tspan></text>
  <path class="d-line" d="M70,208 L70,272" />

  <text class="d-t d-b" x="16" y="308">Tokens in per call</text>
  <text class="d-t d-sm d-b" x="16" y="338">Jev</text>
  <rect class="d-yellow" x="70" y="320" width="5.42" height="24" />
  <text class="d-t d-mono d-b" x="84" y="338">1,147</text>
  <text class="d-t d-sm" x="16" y="370">Haiku</text>
  <rect class="d-box" x="70" y="352" width="200" height="24" />
  <text class="d-t d-mono" x="278" y="370">42,309<tspan class="d-b" dx="10">37x</tspan></text>
  <path class="d-line" d="M70,316 L70,380" />

  <text class="d-t d-b" x="16" y="416">Right answers, of 100</text>
  <text class="d-t d-sm" x="70" y="438" text-anchor="middle">0</text>
  <text class="d-t d-sm" x="350" y="438" text-anchor="middle">100</text>
  <path class="d-line" d="M70,444 L70,452 M350,444 L350,452" />
  <text class="d-t d-sm d-b" x="16" y="472">Jev</text>
  <rect class="d-yellow" x="70" y="454" width="271.6" height="24" />
  <text class="d-t d-mono d-b" x="349.6" y="472">97</text>
  <text class="d-t d-sm" x="16" y="504">Haiku</text>
  <rect class="d-box" x="70" y="486" width="274.4" height="24" />
  <text class="d-t d-mono" x="352.4" y="504">98</text>
  <path class="d-line" d="M70,450 L70,514" />

  <text class="d-t d-sm" x="16" y="550">Haiku runs as a Claude Code agent.</text>
  <text class="d-t d-sm" x="16" y="572">List prices.</text>
</svg>
