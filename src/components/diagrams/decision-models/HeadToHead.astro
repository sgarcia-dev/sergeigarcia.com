<svg viewBox="0 0 420 676" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <!-- Same 10 questions, 40 held-out postings, per posting. Jev = 1 call. Luna and Haiku = 1 agent call each.
       All bars start at x=70. Four panels, each to scale on its own.
       Cost: Jev $0.00011, Luna $0.0011, Haiku $0.0046. Bar length = dollars x 43,478 px ($0.0046 = 200px). Ratios vs Jev: 10x, 41x.
       Seconds: Jev 0.6, Luna 9.9, Haiku 13.5. Bar length = seconds x 14.815 px (13.5 s = 200px).
       Tokens in: Jev 2,669, Luna 13,951, Haiku 43,592. Bar length = tokens / 218 px (43,592 = 200px).
       Accuracy: Jev 95.3%, Luna 94.0%, Haiku 94.0%. Axis 0 to 100%. Bar length = percent x 2.8 px (100% = 280px). -->
  <text class="d-t d-b" x="16" y="28">Same 10 questions</text>
  <text class="d-t d-sm" x="16" y="52">40 held-out postings, per posting</text>
  <text class="d-t d-sm" x="16" y="74">1 call each. Luna and Haiku are agents.</text>

  <!-- Panel 1: cost per posting -->
  <text class="d-t d-b" x="16" y="112">Cost per posting, US dollars</text>
  <text class="d-t d-sm d-b" x="16" y="142">Jev</text>
  <rect class="d-yellow" x="70" y="124" width="4.78" height="24" />
  <text class="d-t d-mono d-b" x="82.8" y="142">$0.00011</text>
  <text class="d-t d-sm" x="16" y="174">Luna</text>
  <rect class="d-box" x="70" y="156" width="47.83" height="24" />
  <text class="d-t d-mono" x="125.8" y="174">$0.0011<tspan class="d-b" dx="10">10x</tspan></text>
  <text class="d-t d-sm" x="16" y="206">Haiku</text>
  <rect class="d-box" x="70" y="188" width="200" height="24" />
  <text class="d-t d-mono" x="278" y="206">$0.0046<tspan class="d-b" dx="10">41x</tspan></text>
  <path class="d-line" d="M70,120 L70,216" />

  <!-- Panel 2: seconds per posting -->
  <text class="d-t d-b" x="16" y="240">Seconds per posting</text>
  <text class="d-t d-sm d-b" x="16" y="270">Jev</text>
  <rect class="d-yellow" x="70" y="252" width="8.89" height="24" />
  <text class="d-t d-mono d-b" x="86.9" y="270">0.6 s</text>
  <text class="d-t d-sm" x="16" y="302">Luna</text>
  <rect class="d-box" x="70" y="284" width="146.67" height="24" />
  <text class="d-t d-mono" x="224.7" y="302">9.9 s</text>
  <text class="d-t d-sm" x="16" y="334">Haiku</text>
  <rect class="d-box" x="70" y="316" width="200" height="24" />
  <text class="d-t d-mono" x="278" y="334">13.5 s</text>
  <path class="d-line" d="M70,248 L70,344" />

  <!-- Panel 3: tokens in per posting -->
  <text class="d-t d-b" x="16" y="368">Tokens in per posting</text>
  <text class="d-t d-sm d-b" x="16" y="398">Jev</text>
  <rect class="d-yellow" x="70" y="380" width="12.24" height="24" />
  <text class="d-t d-mono d-b" x="90.2" y="398">2,669</text>
  <text class="d-t d-sm" x="16" y="430">Luna</text>
  <rect class="d-box" x="70" y="412" width="64" height="24" />
  <text class="d-t d-mono" x="142" y="430">13,951</text>
  <text class="d-t d-sm" x="16" y="462">Haiku</text>
  <rect class="d-box" x="70" y="444" width="200" height="24" />
  <text class="d-t d-mono" x="278" y="462">43,592</text>
  <path class="d-line" d="M70,376 L70,472" />

  <!-- Panel 4: accuracy, axis 0 to 100% -->
  <text class="d-t d-b" x="16" y="496">Accuracy vs labelled answers</text>
  <text class="d-t d-sm" x="70" y="518" text-anchor="middle">0%</text>
  <text class="d-t d-sm" x="350" y="518" text-anchor="middle">100%</text>
  <path class="d-line" d="M70,524 L70,532 M350,524 L350,532" />
  <text class="d-t d-sm d-b" x="16" y="552">Jev</text>
  <rect class="d-yellow" x="70" y="534" width="266.84" height="24" />
  <text class="d-t d-mono d-b" x="344.8" y="552">95.3%</text>
  <text class="d-t d-sm" x="16" y="584">Luna</text>
  <rect class="d-box" x="70" y="566" width="263.2" height="24" />
  <text class="d-t d-mono" x="341.2" y="584">94.0%</text>
  <text class="d-t d-sm" x="16" y="616">Haiku</text>
  <rect class="d-box" x="70" y="598" width="263.2" height="24" />
  <text class="d-t d-mono" x="341.2" y="616">94.0%</text>
  <path class="d-line" d="M70,530 L70,626" />

  <text class="d-t d-sm" x="16" y="658">Luna at low effort. List prices.</text>
</svg>
