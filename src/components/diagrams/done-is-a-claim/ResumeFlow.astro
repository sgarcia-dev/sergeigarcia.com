<svg viewBox="0 0 560 560" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <marker id="arr-resume-flow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="currentColor" />
    </marker>
  </defs>

  <rect class="d-box" x="100" y="10" width="360" height="64" />
  <text class="d-t d-b" x="280" y="38" text-anchor="middle">Approved facts:</text>
  <text class="d-t d-b" x="280" y="62" text-anchor="middle">my master resume</text>
  <path class="d-line" d="M280,74 L280,98" marker-end="url(#arr-resume-flow)" />

  <rect class="d-box" x="100" y="100" width="360" height="48" />
  <text class="d-t d-b" x="280" y="131" text-anchor="middle">Model writes a tailored draft</text>
  <path class="d-line" d="M280,148 L280,172" marker-end="url(#arr-resume-flow)" />

  <rect class="d-cobalt" x="100" y="174" width="360" height="116" />
  <text class="d-t d-t-light" x="280" y="202" text-anchor="middle">Script checks every number,</text>
  <text class="d-t d-t-light" x="280" y="226" text-anchor="middle">job heading (title, dates),</text>
  <text class="d-t d-t-light" x="280" y="250" text-anchor="middle">bullet and skill against</text>
  <text class="d-t d-t-light" x="280" y="274" text-anchor="middle">the approved facts</text>

  <path class="d-line" d="M280,290 L280,310 M140,310 L420,310" />
  <path class="d-line" d="M140,310 L140,334" marker-end="url(#arr-resume-flow)" />
  <path class="d-line" d="M420,310 L420,334" marker-end="url(#arr-resume-flow)" />
  <text class="d-t d-sm" x="432" y="328">all found</text>

  <path class="d-line d-dash" d="M40,336 L40,124 L98,124" marker-end="url(#arr-resume-flow)" />

  <rect class="d-tomato" x="10" y="336" width="260" height="112" />
  <text class="d-t d-t-dark" x="26" y="364">Anything not found:</text>
  <text class="d-t d-t-dark" x="26" y="388">blocked. Reasons go</text>
  <text class="d-t d-t-dark" x="26" y="412">back to the model</text>
  <text class="d-t d-t-dark" x="26" y="436">(2 tries).</text>
  <path class="d-line" d="M140,448 L140,480" marker-end="url(#arr-resume-flow)" />
  <text class="d-t d-sm" x="152" y="470">after 2 fails</text>
  <rect class="d-box" x="10" y="482" width="260" height="64" />
  <text class="d-t d-b" x="26" y="510">Ship the approved</text>
  <text class="d-t d-b" x="26" y="534">base resume instead</text>

  <rect class="d-box" x="290" y="336" width="260" height="88" />
  <text class="d-t" x="306" y="364">A second model</text>
  <text class="d-t" x="306" y="388">reviews the summary</text>
  <text class="d-t" x="306" y="412">wording</text>
  <path class="d-line" d="M420,424 L420,446" marker-end="url(#arr-resume-flow)" />
  <rect class="d-yellow" x="290" y="448" width="260" height="48" />
  <text class="d-t d-t-dark d-b" x="420" y="479" text-anchor="middle">Ship</text>
</svg>
