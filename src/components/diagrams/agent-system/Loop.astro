<svg viewBox="0 0 560 476" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <marker id="arr-loop" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="currentColor" />
    </marker>
  </defs>

  <rect class="d-yellow" x="150" y="10" width="260" height="52" />
  <text class="d-t d-t-dark d-b" x="280" y="42" text-anchor="middle">I ask for something</text>

  <rect class="d-box" x="20" y="110" width="230" height="72" />
  <text class="d-t d-b" x="36" y="140">1. Plan</text>
  <text class="d-t d-sm" x="36" y="164">task folder, status board</text>

  <rect class="d-box" x="20" y="230" width="230" height="72" />
  <text class="d-t d-b" x="36" y="260">2. Packet</text>
  <text class="d-t d-sm" x="36" y="284">goal, files, checks, stop</text>

  <rect class="d-box" x="20" y="350" width="230" height="72" />
  <text class="d-t d-b" x="36" y="380">3. Worker runs</text>
  <text class="d-t d-sm" x="36" y="404">cheapest model that fits</text>

  <rect class="d-cobalt" x="310" y="350" width="230" height="72" />
  <text class="d-t d-t-light d-b" x="326" y="380">4. Check</text>
  <text class="d-t d-t-light d-sm" x="326" y="404">evidence, not claims</text>

  <rect class="d-box" x="310" y="230" width="230" height="72" />
  <text class="d-t d-b" x="326" y="260">5. Accept</text>
  <text class="d-t d-sm" x="326" y="284">update the spec</text>

  <rect class="d-box" x="310" y="110" width="230" height="72" />
  <text class="d-t d-b" x="326" y="140">6. Commit and push</text>
  <text class="d-t d-sm" x="326" y="164">the why goes in git</text>

  <path class="d-line" d="M220,62 L135,108" marker-end="url(#arr-loop)" />
  <path class="d-line" d="M135,182 L135,228" marker-end="url(#arr-loop)" />
  <path class="d-line" d="M135,302 L135,348" marker-end="url(#arr-loop)" />
  <path class="d-line" d="M250,386 L308,386" marker-end="url(#arr-loop)" />
  <path class="d-line" d="M425,350 L425,304" marker-end="url(#arr-loop)" />
  <path class="d-line" d="M425,230 L425,184" marker-end="url(#arr-loop)" />
  <path class="d-line" d="M425,110 L340,64" marker-end="url(#arr-loop)" />

  <path class="d-line d-dash" d="M310,350 L254,304" marker-end="url(#arr-loop)" />
  <path class="d-line d-dash" d="M20,456 L60,456" />
  <text class="d-t d-sm" x="70" y="461">If the check fails: find why, send a smaller packet</text>
</svg>
