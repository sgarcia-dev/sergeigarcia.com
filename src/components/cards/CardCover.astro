---
/**
 * The article cover art in the site's frame: thick black border, hard shadow, a slight tilt.
 * The card places and sizes it (position, width, --cc-rot, --cc-shadow) from its own CSS.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Output width of the optimized image in px. */
  width?: number;
  class?: string;
}
const { src, alt, width = 1400, class: cls } = Astro.props;
---

<div class:list={["card-cover", cls]}>
  <Image src={src} width={width} alt={alt} loading="eager" />
</div>

<style>
  .card-cover {
    position: absolute;
    border: 6px solid #0a0a0a;
    box-shadow: var(--cc-shadow, 16px 16px 0 #0a0a0a);
    background: #fff;
    transform: rotate(var(--cc-rot, -1.5deg));
  }
  .card-cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
