---
import Icon from "./Icon.astro";
/**
 * "Share this post": square icon chips (inline SVG logos, no icon font, no requests) that link to
 * each network's own share page, plus Copy link and a native Share button. Every chip is 44px, with
 * its name in aria-label and a title tooltip. No third-party scripts, nothing loads from another
 * site. The two buttons stay hidden until the small script below confirms the browser can do them.
 */
interface Props {
  /** Canonical absolute URL of the page. */
  url: string;
  title: string;
}
const { url, title } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

type IconName = "linkedin" | "hackernews" | "reddit" | "bluesky" | "x";
const links: { name: string; icon: IconName; href: string }[] = [
  { name: "LinkedIn", icon: "linkedin", href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
  { name: "Hacker News", icon: "hackernews", href: `https://news.ycombinator.com/submitlink?u=${u}&t=${t}` },
  { name: "Reddit", icon: "reddit", href: `https://www.reddit.com/submit?url=${u}&title=${t}&type=LINK` },
  { name: "Bluesky", icon: "bluesky", href: `https://bsky.app/intent/compose?text=${encodeURIComponent(`${title}\n${url}`)}` },
  { name: "X", icon: "x", href: `https://x.com/intent/tweet?url=${u}&text=${t}` },
];
const mail = `mailto:?subject=${t}&body=${encodeURIComponent(`${title}\r\n\r\n${url}`)}`;
---

<aside class="share mt-lg" aria-labelledby="share-h" data-url={url} data-title={title}>
  <h2 id="share-h" class="font-title text-xl">Share this post</h2>
  <ul role="list" class="mt-sm flex flex-wrap gap-sm" data-share-row>
    {
      links.map((link) => (
        <li>
          <a
            class="hit hit-icon"
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Share on ${link.name} (opens in a new tab)`}
            title={`Share on ${link.name}`}
          >
            <Icon name={link.icon} size="lg" />
          </a>
        </li>
      ))
    }
    <li>
      <a class="hit hit-icon" href={mail} aria-label="Share by email" title="Share by email">
        <Icon name="email" size="lg" />
      </a>
    </li>
    <li hidden data-copy-item>
      <button type="button" class="hit hit-icon" data-copy aria-label="Copy link" title="Copy link">
        <Icon name="link" size="lg" />
      </button>
    </li>
    <li hidden data-share-item>
      <button type="button" class="hit hit-icon" data-share aria-label="Share with another app" title="Share with another app">
        <Icon name="share" size="lg" />
      </button>
    </li>
  </ul>
  <p class="label mt-sm" role="status" aria-live="polite" data-status></p>
</aside>

<script is:inline>
  (function () {
    var box = document.currentScript && document.currentScript.previousElementSibling;
    if (!box || !box.classList.contains("share")) return;
    var url = box.getAttribute("data-url");
    var title = box.getAttribute("data-title");
    var status = box.querySelector("[data-status]");
    var timer;
    function say(text) {
      status.textContent = text;
      clearTimeout(timer);
      timer = setTimeout(function () {
        status.textContent = "";
      }, 2500);
    }
    if (navigator.share) {
      box.querySelector("[data-share-item]").hidden = false;
      box.querySelector("[data-share]").addEventListener("click", function () {
        navigator.share({ title: title, url: url }).catch(function () {});
      });
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      box.querySelector("[data-copy-item]").hidden = false;
      box.querySelector("[data-copy]").addEventListener("click", function () {
        navigator.clipboard.writeText(url).then(
          function () {
            say("Copied");
          },
          function () {
            say("Could not copy. Select the address bar instead.");
          },
        );
      });
    }
  })();
</script>

<style>
  /* Reserve the status line so "Copied" never shifts the page. */
  .share [data-status] {
    min-height: calc(var(--text-xs) * 1.4);
  }
</style>
