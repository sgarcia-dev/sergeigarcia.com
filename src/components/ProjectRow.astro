---
/** One project in a list: period on the rail, linked title, role (and company), summary, skills. */
import type { CollectionEntry } from "astro:content";
import Pills from "./Pills.astro";
import { vtName } from "../lib/content";

interface Props {
  entry: CollectionEntry<"projects">;
}
const { entry } = Astro.props;
const { title, summary, period, role, company, skills } = entry.data;
---

<li class="row">
  <p class="label">{period}</p>
  <div>
    <h2 class="font-title text-xl">
      <a
        class="row-link inline-block"
        href={`/projects/${entry.id}/`}
        style={`view-transition-name: ${vtName("projects", entry.id)}`}>{title}</a
      >
    </h2>
    <p class="mt-xs">
      {company ? <><strong class="font-bold">{company}</strong>, {role}</> : role}
    </p>
    <p class="mt-xs max-w-prose">{summary}</p>
    {
      skills.length > 0 && (
        <div class="mt-sm">
          <Pills skills={skills} />
        </div>
      )
    }
  </div>
</li>
