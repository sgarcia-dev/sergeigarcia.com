---
/** Frame based on the hero's on-device phone, with media supplied by the caller. */
---
<div class="phone-frame">
  <span class="side s1" aria-hidden="true"></span><span class="side s2" aria-hidden="true"></span><span class="side s3" aria-hidden="true"></span>
  <div class="screen"><slot /></div>
  <i class="camera" aria-hidden="true"></i>
</div>
<style>
  .phone-frame {
    position: relative;
    width: min(74vw, 300px);
    padding: 7px;
    border-radius: 30px;
    background: linear-gradient(145deg, #565b59, #1d201f 38%, #343836 70%, #1a1c1b);
    box-shadow: 0 34px 60px -22px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.05);
  }
  .phone-frame::before { content: ""; position: absolute; inset: 2px; border-radius: 28px; background: #030404; }
  .side { position: absolute; width: 3px; border-radius: 2px; background: #2b2f2d; }
  .s1 { right: -2.5px; top: 150px; height: 58px; }
  .s2 { left: -2.5px; top: 130px; height: 34px; }
  .s3 { left: -2.5px; top: 178px; height: 62px; }
  .screen { position: relative; overflow: hidden; border-radius: 23px; background: #000; }
  .screen :global(.fv) { border-radius: 0; }
  .camera { position: absolute; top: 15px; left: 50%; width: 11px; height: 11px; margin-left: -5.5px; border-radius: 50%; background: #000; box-shadow: inset 0 0 0 2.5px #14181a, 0 0 0 1px #000; z-index: 3; }
</style>
