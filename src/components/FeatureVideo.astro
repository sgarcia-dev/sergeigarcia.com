---
/**
 * A short looping screen recording that sits where a phone screenshot sits.
 *
 * Frame decision: the phone frame (.phone, with its tilt and glow) lives in the whisper-for-android
 * page, so this component does NOT draw one. It renders only the media and is meant to be placed
 * inside the page's `<div class="phone" data-tilt>` in place of the `<img>`. It rounds its own
 * corners (2.2rem) to match the screen inside that frame and fills the frame width.
 *
 * Files: /whisper-for-android/video/NAME.webm, then NAME.mp4. Sources are set lazily by the
 * script below. The poster stays as a still image when the reader prefers reduced motion, has
 * Save-Data on, is on a 2g connection, or when the video fails to load.
 *
 * Props:
 *   name    File name without extension, for example "bubble".
 *   poster  URL of the still image shown before and instead of the video.
 *   alt     Describes the screen. The video itself is hidden from screen readers.
 *   label   Optional small pill over the bottom of the screen, for example "See it in action".
 *   width, height  Pixel size of the poster. Sets the fixed aspect ratio so nothing shifts.
 *                  Defaults to the screenshot size used on the page (1080 by 2138).
 */
interface Props {
  name: string;
  poster: string;
  alt: string;
  label?: string;
  width?: number;
  height?: number;
}
const { name, poster, alt, label, width = 1080, height = 2138 } = Astro.props;
const dir = "/whisper-for-android/video/";
---

<div class="fv" data-feature-video style={`aspect-ratio: ${width} / ${height};`}>
  <img class="fv-poster" src={poster} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  <video
    class="fv-video"
    muted
    playsinline
    loop
    preload="none"
    poster={poster}
    aria-hidden="true"
    tabindex="-1"
    disablepictureinpicture
    data-webm={`${dir}${name}.webm`}
    data-mp4={`${dir}${name}.mp4`}></video>
  {label && <span class="fv-label" aria-hidden="true">{label}</span>}
  <button class="fv-play" type="button" aria-label="Play the screen recording" hidden>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
  </button>
</div>

<style>
  .fv {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 2.2rem;
    background: #050807;
  }
  .fv-poster,
  .fv-video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .fv-video {
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  .fv.is-ready .fv-video {
    opacity: 1;
  }
  .fv.is-static .fv-video {
    display: none;
  }
  .fv-label {
    position: absolute;
    left: 50%;
    bottom: 0.9rem;
    transform: translateX(-50%);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: rgb(5 8 7 / 0.72);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
  }
  .fv-play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgb(5 8 7 / 0.72);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
    color: #fff;
    cursor: pointer;
  }
  .fv-play[hidden] {
    display: none;
  }
  .fv-play:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .fv.is-tap .fv-video {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .fv-video {
      transition: none;
    }
  }
</style>

<script>
  // One shared script for every instance on the page. Astro bundles it once.
  //
  // Autoplay is a best effort: a phone can refuse it (power saving, browser policy), be slow
  // to load it, or fail to decode one format. So every video gets a play button that appears
  // whenever the video is not actually playing a few seconds after it came into view, and a
  // tap always works. Reduced motion and Save-Data never autoplay; they get the button at once.
  // Add ?fvdebug to the URL to print each video's state on the page.
  const nodes = Array.from(document.querySelectorAll<HTMLElement>("[data-feature-video]"));
  const debug = new URLSearchParams(location.search).has("fvdebug");

  const conn = (navigator as any).connection;
  const keepPoster =
    window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
    !!conn?.saveData ||
    conn?.effectiveType === "2g" ||
    conn?.effectiveType === "slow-2g";
  const canObserve = "IntersectionObserver" in window;

  const parts = (box: HTMLElement) => ({
    video: box.querySelector<HTMLVideoElement>("video")!,
    btn: box.querySelector<HTMLButtonElement>(".fv-play"),
  });

  const showButton = (box: HTMLElement) => {
    const { btn } = parts(box);
    if (btn && !box.classList.contains("is-failed")) btn.hidden = false;
  };
  const hideButton = (box: HTMLElement) => {
    const { btn } = parts(box);
    if (btn) btn.hidden = true;
  };

  // Try each source in order; move on when one cannot load or decode.
  const sourcesOf = (video: HTMLVideoElement) =>
    [
      [video.dataset.webm, "video/webm"],
      [video.dataset.mp4, "video/mp4"],
    ].filter(([src, type]) => src && video.canPlayType(type!) !== "") as Array<[string, string]>;

  const started = new WeakSet<HTMLVideoElement>();
  const start = (box: HTMLElement) => {
    const { video } = parts(box);
    if (started.has(video)) return;
    started.add(video);
    const list = sourcesOf(video);
    let i = 0;
    const next = () => {
      if (i >= list.length) {
        box.classList.add("is-failed", "is-static");
        hideButton(box);
        return;
      }
      video.src = list[i++][0];
      video.load();
    };
    video.addEventListener("error", () => {
      const wasPlaying = !video.paused;
      next();
      if (wasPlaying || box.dataset.wantPlay) play(box);
    });
    const ready = () => box.classList.add("is-ready");
    video.addEventListener("loadeddata", ready);
    video.addEventListener("playing", () => {
      ready();
      hideButton(box);
    });
    video.addEventListener("pause", () => {
      if (box.dataset.inView) showButton(box);
    });
    next();
  };

  const play = (box: HTMLElement) => {
    const { video } = parts(box);
    if (box.classList.contains("is-failed")) return;
    start(box);
    box.classList.remove("is-static");
    box.dataset.wantPlay = "1";
    video.play().catch(() => showButton(box));
  };

  nodes.forEach((box) => {
    const { video, btn } = parts(box);
    if (!video) return;
    // A tap on the button, or anywhere on the screen while paused, plays this video.
    const onTap = () => {
      if (video.paused) play(box);
      else video.pause();
    };
    btn?.addEventListener("click", onTap);
    box.addEventListener("click", (e) => {
      if (e.target !== btn && !btn?.contains(e.target as Node)) onTap();
    });
    box.style.cursor = "pointer";
    if (keepPoster || !canObserve) {
      box.classList.add("is-static");
      showButton(box);
    }
  });

  if (!keepPoster && canObserve) {
    // Start loading well before a video scrolls into view.
    const loader = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          start(e.target as HTMLElement);
          loader.unobserve(e.target);
        }
      },
      { rootMargin: "600px 0px" },
    );

    // Play when half of the video, or half of the screen, is covered by it; pause otherwise.
    // If it is still not playing 2.5 s after coming into view, offer the play button.
    const timers = new WeakMap<HTMLElement, number>();
    const player = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const box = e.target as HTMLElement;
          const { video } = parts(box);
          const rootH = e.rootBounds?.height || window.innerHeight;
          const visible = e.isIntersecting && (e.intersectionRatio >= 0.5 || e.intersectionRect.height >= rootH * 0.5);
          if (visible) {
            if (box.dataset.inView) continue;
            box.dataset.inView = "1";
            play(box);
            clearTimeout(timers.get(box));
            timers.set(box, window.setTimeout(() => {
              if (box.dataset.inView && (video.paused || video.readyState < 3)) showButton(box);
            }, 2500));
          } else {
            delete box.dataset.inView;
            clearTimeout(timers.get(box));
            if (!video.paused) video.pause();
          }
        }
      },
      { threshold: [0, 0.25, 0.5, 0.75, 1] },
    );

    nodes.forEach((n) => {
      loader.observe(n);
      player.observe(n);
    });
  }

  if (debug) {
    nodes.forEach((box) => {
      const { video, btn } = parts(box);
      const tag = document.createElement("pre");
      tag.style.cssText =
        "position:absolute;left:4px;right:4px;top:4px;margin:0;padding:4px;font:10px/1.3 monospace;color:#fff;background:rgb(0 0 0 / 0.7);border-radius:6px;white-space:pre-wrap;z-index:5;pointer-events:none";
      box.appendChild(tag);
      const conn2 = (navigator as any).connection;
      const tick = () => {
        tag.textContent =
          `${(video.currentSrc || "no src").split("/video/")[1] || video.currentSrc || "no src"}\n` +
          `paused=${video.paused} t=${video.currentTime.toFixed(1)} ready=${video.readyState} net=${video.networkState}` +
          ` err=${video.error ? video.error.code + " " + (video.error.message || "") : "none"}\n` +
          `class=${box.className} button=${btn && !btn.hidden} inView=${!!box.dataset.inView}\n` +
          `reduce=${matchMedia("(prefers-reduced-motion: reduce)").matches} saveData=${!!conn2?.saveData} net=${conn2?.effectiveType ?? "?"}` +
          ` webm=${video.canPlayType("video/webm") || "no"} mp4=${video.canPlayType("video/mp4") || "no"}`;
      };
      tick();
      window.setInterval(tick, 500);
    });
  }
</script>
