---
/**
 * The end-of-post author card. Two switches in src/lib/site.ts control it for the whole site:
 * SITE.availability ("looking", "open" or "off") and SITE.authorCardVariant ("A", "B" or "C").
 * With "off" nothing is rendered. The lab page (src/pages/lab/author-card.astro) shows every look.
 */
import AuthorCardA from "./AuthorCardA.astro";
import AuthorCardB from "./AuthorCardB.astro";
import AuthorCardC from "./AuthorCardC.astro";
import { SITE } from "../lib/site";

const variant = SITE.authorCardVariant;
---

{variant === "A" && <AuthorCardA />}
{variant === "B" && <AuthorCardB />}
{variant === "C" && <AuthorCardC />}
