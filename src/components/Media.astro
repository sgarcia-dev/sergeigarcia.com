---
/**
 * Visual anchor for a project page: the cover in a 16:9 frame, or a yellow
 * typographic card (always for confidential work, which never shows screenshots).
 */
import type { CollectionEntry } from "astro:content";
import Thumb from "./Thumb.astro";

interface Props {
  entry: CollectionEntry<"projects">;
}
const { entry } = Astro.props;
const { title, company, cover, coverAlt, confidential } = entry.data;
const coverImage = confidential ? undefined : cover;
---

{
  coverImage ? (
    <Thumb image={coverImage} alt={coverAlt ?? title} size="lg" ratio="wide" eager />
  ) : (
    <figure class="type-card band-yellow">
      <p class="font-display text-h2 tracking-tight">{company ?? "Personal project"}</p>
      <p class="label">{confidential ? "Internal work, so there are no screenshots." : "Write-up only. The code is private."}</p>
    </figure>
  )
}
