---
/** One work role in a list: period on the rail, linked company, title and role, summary, skills. */
import type { CollectionEntry } from "astro:content";
import Pills from "./Pills.astro";
import { vtName } from "../lib/content";

interface Props {
  entry: CollectionEntry<"work">;
}
const { entry } = Astro.props;
const { title, summary, period, role, company, skills } = entry.data;
---

<li class="row">
  <p class="label">{period}</p>
  <div>
    <h2 class="font-title text-xl">
      <a
        class="row-link inline-block"
        href={`/work/${entry.id}/`}
        style={`view-transition-name: ${vtName("work", entry.id)}`}>{company}</a
      >
    </h2>
    <p class="mt-xs">
      <strong class="font-bold">{title}</strong>{role !== title && <>, {role}</>}
    </p>
    <p class="mt-xs max-w-prose">{summary}</p>
    {
      skills.length > 0 && (
        <div class="mt-sm">
          <Pills skills={skills} />
        </div>
      )
    }
  </div>
</li>
