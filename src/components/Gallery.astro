---
/** A small row of framed screenshots with one shared caption. */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  items: { src: ImageMetadata; alt: string }[];
  caption?: string;
}
const { items, caption } = Astro.props;
---

{
  items.length > 0 && (
    <figure class="gallery">
      <div class="gallery-grid">
        {items.map((item) => (
          <div class="gallery-item" data-tall={item.src.height > item.src.width ? "" : undefined}>
            <Picture
              src={item.src}
              formats={["avif", "webp"]}
              widths={[360, 720, 1080]}
              sizes="(min-width: 64rem) 30rem, 100vw"
              alt={item.alt}
              loading="lazy"
              decoding="async"
              pictureAttributes={{ class: "block" }}
            />
          </div>
        ))}
      </div>
      {caption && <figcaption class="label mt-md">{caption}</figcaption>}
    </figure>
  )
}

<style>
  .gallery-grid {
    display: grid;
    gap: var(--spacing-md);
    align-items: start;
  }
  @media (min-width: 48rem) {
    .gallery-grid {
      grid-template-columns: 1fr 3fr;
    }
  }
  .gallery-item {
    border: var(--rule-thick) solid var(--edge);
    box-shadow: 8px 8px 0 var(--edge);
    background: var(--color-white);
  }
  .gallery-item[data-tall] {
    max-width: 16rem;
  }
  .gallery-item :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
