---
/**
 * Top block for every inner page: a colored band with the page title in display type.
 * `vt` sets the view-transition name so a list title morphs into this heading.
 */
interface Props {
  title: string;
  band?: "yellow" | "cobalt" | "tomato";
  eyebrow?: string;
  vt?: string;
  size?: "h2" | "xl";
}
const { title, band = "yellow", eyebrow, vt, size = "h2" } = Astro.props;
---

<section class:list={["edge-b", `band-${band}`]}>
  <div class="shell py-lg lg:py-xl">
    {eyebrow && <p class="label mb-sm">{eyebrow}</p>}
    <h1
      class:list={[
        "max-w-title tracking-tight",
        size === "h2" ? "font-display text-h2" : "font-title text-xl",
      ]}
      style={vt ? `view-transition-name: ${vt}` : undefined}
    >
      {title}
    </h1>
    <slot />
  </div>
</section>
