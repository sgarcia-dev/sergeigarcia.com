---
import { NAV } from "../lib/site";
import Logo from "./Logo.astro";

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="edge-b site-header">
  <div class="shell flex flex-col gap-sm py-sm md:flex-row md:items-center md:justify-between site-header-inner">
    <a href="/" class:list={["hit hit-logo self-start", !home && "vt-site-name"]} aria-label="Sergei Garcia, home">
      <Logo class="logo-mark" />
      <span class="logo-name label">Sergei Garcia</span>
    </a>
    <nav aria-label="Primary" class="site-nav">
      <ul role="list" class="grid grid-cols-4 gap-xs md:flex md:gap-sm">
        {
          NAV.map((item) => (
            <li>
              <a class="hit hit-nav" href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  :global(.logo-mark) {
    display: block;
    height: 1.5rem;
    width: auto;
  }
  /* The name shows from tablet width up. On phones the chip is just the mark. */
  .logo-name {
    display: none;
  }
  @media (min-width: 48rem) {
    .logo-name {
      display: inline-block;
    }
  }
  .vt-site-name {
    view-transition-name: site-name;
  }
</style>
