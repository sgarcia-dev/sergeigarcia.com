---
import { NAV } from "../lib/site";
import Logo from "./Logo.astro";

interface Props {
  home?: boolean;
  /** Posts and case studies only: renders the live "minutes left" chip (see src/scripts/readtime.ts). */
  readMinutes?: number;
}
const { home = false, readMinutes } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<!-- Sticky on every page; src/styles/motion.css compacts it after ~80px of scroll. -->
<header class="edge-b site-header">
  <div class="shell site-header-inner flex flex-col gap-sm py-sm md:flex-row md:items-center md:justify-between">
    <a href="/" class:list={["hit hit-logo self-start", !home && "vt-site-name"]} aria-label="Sergei Garcia, home">
      <Logo class="logo-mark" />
    </a>
    <nav aria-label="Primary" class="site-nav md:ml-auto">
      <ul role="list" class="grid grid-cols-4 gap-xs md:flex md:gap-sm">
        {
          NAV.map((item) => (
            <li>
              <a class="hit hit-nav" href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      readMinutes && (
        <div class="rt-chip" data-rt data-total={readMinutes} aria-hidden="true">
          <span class="rt-box">
            <span class="rt-live">
              <b class="rt-main">{readMinutes} min left</b>
              <span class="rt-tail">· settle in</span>
            </span>
          </span>
          <span class="rt-emoji">🌱</span>
        </div>
      )
    }
  </div>
</header>

<style>
  :global(.logo-mark) {
    display: block;
    height: 1.75rem;
    width: auto;
  }
  .vt-site-name {
    view-transition-name: site-name;
  }
</style>
