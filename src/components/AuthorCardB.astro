---
/**
 * Author card, variant B "Bold". A cobalt block with the site's hard shadow, a big serif line with the
 * highlighter on the key phrase, and the headshot stuck on the corner like a sticker. Same frame as the
 * TL;DR box and pull quote, so it reads as part of the post. Text is white on cobalt (AA); the
 * highlighter on cobalt is the yellow block with black text from lively.css.
 * Renders nothing when the mode is "off".
 */
import AuthorPhoto from "./AuthorPhoto.astro";
import AuthorActions from "./AuthorActions.astro";
import { SITE, type Availability } from "../lib/site";
import { AUTHOR, authorLine } from "../lib/authorCard";

interface Props {
  mode?: Availability;
}
const { mode = SITE.availability } = Astro.props;
const line = authorLine(mode);
---

{
  line && (
    <aside class="author-card ac-b band-cobalt" aria-label="About the author" data-author-card="B" data-availability={mode}>
      <div class="ac-b-sticker">
        <AuthorPhoto size="6rem" class="ac-b-photo" />
      </div>
      <div class="ac-b-head">
        <p class="ac-b-name">
          <span class="font-title">{AUTHOR.name}</span>
          <span class="ac-b-role">{AUTHOR.role}</span>
        </p>
        <p class="ac-b-line font-title">
          {line.before}
          <span class="lv-mark lv-mark--band">{line.mark}</span>
          {line.after}
        </p>
      </div>
      <p class="ac-b-intro">{AUTHOR.tagline}</p>
      <AuthorActions class="ac-b-actions" />
    </aside>
  )
}

<style>
  .ac-b {
    position: relative;
    /* Room above for the sticker that hangs over the top edge. */
    margin-top: calc(var(--spacing-lg) + 2.5rem);
    padding: calc(var(--spacing-md) + 3rem) var(--spacing-sm) var(--spacing-md);
    border: var(--rule-thick) solid var(--edge);
    box-shadow: 8px 8px 0 var(--edge);
  }
  .ac-b-sticker {
    position: absolute;
    top: -3rem;
    left: var(--spacing-sm);
    transform: rotate(-4deg);
  }
  /* A sticker has a white die-cut edge and a little hard shadow. */
  .ac-b-sticker :global(.ac-photo) {
    --ac-edge: var(--color-black);
    box-shadow:
      0 0 0 4px var(--color-white),
      5px 5px 0 4px var(--color-black);
  }
  .ac-b-name {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--spacing-xs);
    font-size: var(--text-lg);
    line-height: 1.2;
  }
  .ac-b-role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
  }
  .ac-b-line {
    margin: var(--spacing-xs) 0 0;
    font-size: var(--text-xl);
    line-height: var(--text-xl--line-height);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .ac-b-intro {
    margin: var(--spacing-sm) 0 0;
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
  }
  .ac-b :global(.ac-actions) {
    margin-top: var(--spacing-md);
  }
  @media (min-width: 48rem) {
    .ac-b {
      padding: var(--spacing-md);
    }
    .ac-b-sticker {
      left: auto;
      right: var(--spacing-md);
      top: -3.5rem;
      transform: rotate(4deg);
    }
    .ac-b :global(.ac-photo) {
      --ac-size: 8rem;
    }
    /* Keep the first lines clear of the sticker. */
    .ac-b-head {
      padding-right: 9.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ac-b-sticker {
      transform: none;
    }
  }
</style>
