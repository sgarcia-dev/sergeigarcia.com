    | "download"
    | "reddit"
    | "bluesky"
    | "x"
    | "hackernews"
    | "link"
    | "share"
    | "play";
  /** "md" (1.25rem) sits beside 13px mono text; "lg" (1.5rem) fills an icon-only chip; "xl" is for the big play button. */
  size?: "md" | "lg" | "xl";
}
