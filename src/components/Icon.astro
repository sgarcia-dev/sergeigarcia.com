---

<svg class="icon" data-size={size} viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true" focusable="false">
  <path d={paths[name]}></path>
</svg>

<style>
  /* 1.25rem: one size for all contact icons, sits beside 13px mono text. */
  .icon {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
  }
  .icon[data-size="lg"] {
    width: 1.5rem;
    height: 1.5rem;
  }
  .icon[data-size="xl"] {
    width: 3rem;
    height: 3rem;
  }
</style>
