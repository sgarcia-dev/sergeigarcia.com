---
/**
 * The picture part of a design, filled in by what the page has:
 *   post  the article cover art
 *   home  the headshot
 *   page  a small stack of page wireframes (no art exists for generic pages)
 * mode "bleed" fills its parent. mode "framed" draws one tilted, framed picture in the middle of it.
 * Its images are tagged data-t="art" so the safe-box check does not mistake them for the owner's avatar.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import headshot from "../../assets/about/headshot.jpg";
import type { Kind } from "../../lib/social";

interface Props {
  kind: Kind;
  cover?: ImageMetadata;
  mode: "bleed" | "framed";
  /** Size of the framed picture, in px wide. */
  frameW?: number;
}
const { kind, cover, mode, frameW = 360 } = Astro.props;
const hasCover = kind === "post" && cover;
---

{
  mode === "bleed" ? (
    hasCover ? (
      <Image src={cover} width={1200} alt="" class="art-bleed" data-t="art" loading="eager" />
    ) : (
      <div class="art-field">
        {kind === "home" ? (
          <div class="art-disc">
            <Image src={headshot} width={400} height={400} alt="" class="art-face" data-t="avatar" loading="eager" />
          </div>
        ) : (
          <div class="wf-stack" aria-hidden="true">
            <div class="wf wf-1"><b></b><i></i><i></i><i></i></div>
            <div class="wf wf-2"><b></b><i></i><i></i><i></i></div>
            <div class="wf wf-3"><b></b><i></i><i></i><i></i></div>
          </div>
        )}
      </div>
    )
  ) : (
    <div class="art-framed" style={`--fw:${frameW}px`}>
      {hasCover ? (
        <Image src={cover} width={900} alt="" class="art-pic" data-t="art" loading="eager" />
      ) : kind === "home" ? (
        <Image src={headshot} width={400} height={400} alt="" class="art-pic art-pic--sq" data-t="art" loading="eager" />
      ) : (
        <div class="wf-stack wf-stack--framed" aria-hidden="true">
          <div class="wf wf-1"><b></b><i></i><i></i><i></i></div>
          <div class="wf wf-2"><b></b><i></i><i></i><i></i></div>
          <div class="wf wf-3"><b></b><i></i><i></i><i></i></div>
        </div>
      )}
    </div>
  )
}

<style>
  .art-bleed {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    background: #fff;
  }
  .art-field {
    position: relative;
    width: 100%;
    height: 100%;
    background: #ffd400;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .art-disc {
    width: 272px;
    height: 272px;
    border-radius: 50%;
    background: #0a0a0a;
    display: grid;
    place-items: center;
    box-shadow: 12px 12px 0 #1f3fd1;
  }
  .art-face {
    display: block;
    width: 248px;
    height: 248px;
    border-radius: 50%;
    object-fit: cover;
    border: 8px solid #fff;
  }
  .art-framed {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .art-pic {
    display: block;
    width: var(--fw);
    height: auto;
    border: 6px solid #0a0a0a;
    box-shadow: 14px 14px 0 #0a0a0a;
    background: #fff;
    transform: rotate(-3deg);
  }
  .art-pic--sq {
    height: var(--fw);
    object-fit: cover;
  }
  /* Page wireframes: three tilted white cards with a colored head and text lines. */
  .wf-stack {
    position: relative;
    width: 520px;
    height: 260px;
  }
  .art-field > .wf-stack {
    margin-top: 84px;
    transform: scale(0.86);
  }
  .wf-stack--framed {
    width: 340px;
    height: 330px;
    transform: scale(0.78);
  }
  .wf {
    position: absolute;
    top: 30px;
    width: 190px;
    height: 200px;
    padding: 14px;
    background: #fff;
    border: 6px solid #0a0a0a;
    box-shadow: 8px 8px 0 #0a0a0a;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .wf b {
    display: block;
    height: 56px;
    background: #1f3fd1;
    border: 4px solid #0a0a0a;
  }
  .wf i {
    display: block;
    height: 12px;
    background: #0a0a0a;
  }
  .wf i:nth-of-type(2) {
    width: 80%;
  }
  .wf i:nth-of-type(3) {
    width: 55%;
  }
  .wf-1 {
    left: 0;
    transform: rotate(-7deg);
  }
  .wf-2 {
    left: 165px;
    top: 10px;
    z-index: 1;
  }
  .wf-2 b {
    background: #ff6a44;
  }
  .wf-3 {
    left: 330px;
    transform: rotate(6deg);
  }
  .wf-stack--framed .wf-1 {
    left: 0;
  }
  .wf-stack--framed .wf-2 {
    left: 75px;
  }
  .wf-stack--framed .wf-3 {
    left: 150px;
    top: 90px;
  }
</style>
