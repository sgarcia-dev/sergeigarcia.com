---
/**
 * A-3 TL;DR card. Cobalt hatch, a big full title, and a big TL;DR box (short TL;DR at the biggest
 * size that fits) with its yellow label and hard shadow. A white name chip sits between them. The
 * cover peeks in from the right edge as decoration. Everything important is in the middle column.
 */
import OgFrame from "./OgFrame.astro";
import OgTitle from "./OgTitle.astro";
import OgIdentity from "./OgIdentity.astro";
import OgCover from "./OgCover.astro";
import OgTldr from "./OgTldr.astro";
import { chooseTitle, fitSize, plain, TITLE_SPECS, type Sample } from "../../lib/social";

interface Props {
  s: Sample;
  design: string;
}
const { s, design } = Astro.props;
const t = chooseTitle(s, TITLE_SPECS.a3);
const tl = fitSize(s.summaryShort, { w: 536, h: 176 }, { max: 46, min: 20, lh: 1.28, cw: 0.54 });
---

<OgFrame label={`TL;DR card design, 1200 by 630, ${plain(t.text)}`} design={design} sample={s.id} bg="#1f3fd1">
  <span class="tex tex-hatch-c"></span>
  {s.cover && <OgCover src={s.cover} w={300} left={956} top={300} rot={7} border={5} shadow={10} />}
  <div class="head"><OgTitle text={t.text} size={t.size} lh={1} variant={t.variant} /></div>
  <div class="who"><OgIdentity avatar={44} ring={3} name={24} /></div>
  <div class="box"><OgTldr text={s.summaryShort} size={tl} /></div>
</OgFrame>

<style>
  .head {
    position: absolute;
    left: 300px;
    width: 600px;
    top: 22px;
    height: 254px;
    display: flex;
    align-items: center;
    color: #fff;
    --mk-bg: #ffd400;
    --mk-ink: #0a0a0a;
  }
  .who {
    position: absolute;
    left: 660px;
    top: 286px;
    padding: 6px 18px 6px 6px;
    border: 4px solid #0a0a0a;
    border-radius: 999px;
    background: #fff;
    box-shadow: 5px 5px 0 #0a0a0a;
    z-index: 3;
    --id-ink: #0a0a0a;
    --id-ring: #0a0a0a;
  }
  .box {
    position: absolute;
    left: 300px;
    width: 596px;
    top: 362px;
  }
</style>
