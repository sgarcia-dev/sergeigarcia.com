---
/**
 * A-1 Black poster. Round 1's type-only design, which the owner liked, with the site's personality
 * added: faint hatch, a yellow highlighter block, avatar and name in the card style, and a tilted
 * cover on the edge. Title and name are centered in the middle column.
 */
import OgFrame from "./OgFrame.astro";
import OgTitle from "./OgTitle.astro";
import OgIdentity from "./OgIdentity.astro";
import OgCover from "./OgCover.astro";
import { fitSize, plain, type Sample } from "../../lib/social";

interface Props {
  s: Sample;
  design: string;
}
const { s, design } = Astro.props;
const size = fitSize(s.titleShort, { w: 600, h: 350 }, { max: 112, lh: 1 });
---

<OgFrame label={`Black poster design, 1200 by 630, ${plain(s.titleShort)}`} design={design} sample={s.id} bg="#0a0a0a">
  <span class="tex tex-hatch-k"></span>
  <span class="bar"></span>
  {s.cover && <OgCover src={s.cover} w={236} left={944} top={96} rot={6} border={5} shadow={10} />}
  <div class="head"><OgTitle text={s.titleShort} size={size} lh={1} /></div>
  <div class="who"><OgIdentity avatar={76} ring={4} name={34} site={24} /></div>
</OgFrame>

<style>
  .bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 40px;
    background: #ffd400;
  }
  .head {
    position: absolute;
    left: 300px;
    width: 600px;
    top: 56px;
    height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    --mk-bg: #ffd400;
    --mk-ink: #0a0a0a;
  }
  .who {
    position: absolute;
    left: 300px;
    width: 600px;
    top: 484px;
    display: flex;
    justify-content: center;
    --id-ink: #fff;
    --id-site: #ffd400;
    --id-ring: #fff;
  }
</style>
