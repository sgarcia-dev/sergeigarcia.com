---
/**
 * A-1 Black poster. Text on the left, image on the right, almost no empty space. The full title
 * fills the top of the middle square, avatar and name sit bottom left, and the cover is big at the
 * bottom right with a yellow hard shadow. It runs off the right edge, so a square crop keeps its
 * left 60 percent (the robot and most of the grid); the 2:1 crop keeps all of it.
 */
import OgFrame from "./OgFrame.astro";
import OgTitle from "./OgTitle.astro";
import OgIdentity from "./OgIdentity.astro";
import OgCover from "./OgCover.astro";
import { chooseTitle, plain, TITLE_SPECS, type Sample } from "../../lib/social";

interface Props {
  s: Sample;
  design: string;
}
const { s, design } = Astro.props;
const t = chooseTitle(s, TITLE_SPECS.a1);
---

<OgFrame label={`Black poster design, 1200 by 630, ${plain(t.text)}`} design={design} sample={s.id} bg="#0a0a0a">
  <span class="tex tex-hatch-k"></span>
  <span class="bar"></span>
  <div class="head"><OgTitle text={t.text} size={t.size} lh={1} variant={t.variant} /></div>
  <div class="who"><OgIdentity avatar={128} ring={5} name={30} site={18} layout="stack" /></div>
  {s.cover && <OgCover src={s.cover} w={572} left={548} top={322} rot={-2} border={6} shadow={12} borderColor="#ffffff" shadowColor="#ffd400" />}
</OgFrame>

<style>
  .bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 40px;
    background: #ffd400;
  }
  .head {
    position: absolute;
    left: 300px;
    width: 600px;
    top: 44px;
    height: 268px;
    display: flex;
    align-items: center;
    color: #fff;
    --mk-bg: #ffd400;
    --mk-ink: #0a0a0a;
  }
  .who {
    position: absolute;
    left: 300px;
    width: 236px;
    top: 350px;
    --id-ink: #fff;
    --id-site: #ffd400;
    --id-ring: #ffd400;
  }
</style>
