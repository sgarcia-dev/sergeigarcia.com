---
/**
 * H-4 Stacked bands. A tall yellow band with the giant name over a cobalt band. A tilted white role
 * chip with the tiny avatar sits on the seam, then a big tagline with a yellow highlighter block.
 * Both bands run full width; all the text sits in the middle column.
 */
import OgFrame from "./OgFrame.astro";
import OgTitle from "./OgTitle.astro";
import OgIdentity from "./OgIdentity.astro";
import OgMarked from "./OgMarked.astro";
import { fitSize, plain, HOME, type Sample } from "../../lib/social";

interface Props {
  s: Sample;
  design: string;
}
const { s, design } = Astro.props;
const size = fitSize(plain(s.title), { w: 600, h: 324 }, { max: 230, lh: 0.92 });
const tag = fitSize(s.summaryShort, { w: 600, h: 160 }, { max: 56, lh: 1.08 });
---

<OgFrame label={`Stacked bands design, 1200 by 630, ${plain(s.title)}`} design={design} sample={s.id} bg="#1f3fd1">
  <div class="top"><span class="tex tex-dots-y"></span></div>
  <span class="tex tex-dots-c" style="top:392px"></span>
  <div class="nm"><OgTitle text={s.title} size={size} lh={0.92} marks={false} /></div>
  <div class="who chip">
    <OgIdentity avatar={44} ring={3} />
    <span class="role" data-t="sub">{HOME.role}</span>
  </div>
  <p class="tag-line" data-t="summary" style={`font-size:${tag}px`}><OgMarked text={s.summaryShort} /></p>
</OgFrame>

<style>
  .top {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 392px;
    border-bottom: 6px solid #0a0a0a;
    overflow: hidden;
  }
  .nm {
    position: absolute;
    left: 300px;
    width: 600px;
    top: 48px;
    height: 326px;
    z-index: 2;
    color: #0a0a0a;
  }
  .who.chip {
    position: absolute;
    left: 300px;
    top: 372px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 5px 16px 5px 5px;
    transform: rotate(-1.5deg);
    box-shadow: 5px 5px 0 #0a0a0a;
    --id-ring: #0a0a0a;
  }
  .role {
    font-size: 20px;
    color: #0a0a0a;
  }
  .tag-line {
    position: absolute;
    left: 300px;
    width: 600px;
    top: 450px;
    z-index: 2;
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.08;
    text-wrap: balance;
    --mk-bg: #ffd400;
    --mk-ink: #0a0a0a;
  }
</style>
