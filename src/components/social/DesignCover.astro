---
/**
 * S-1 Cover stage. The article art fills the top, a cobalt band carries the title, a white name
 * chip sits on the art. Title and chip live in the middle 600px column (x 300 to 900), so a
 * square crop and a 2:1 crop keep them whole.
 */
import type { ImageMetadata } from "astro";
import OgFrame from "./OgFrame.astro";
import OgArt from "./OgArt.astro";
import OgTitle from "./OgTitle.astro";
import OgIdentity from "./OgIdentity.astro";
import { fitSize, type Kind } from "../../lib/social";

interface Props {
  kind: Kind;
  title: string;
  highlight?: string;
  cover?: ImageMetadata;
  summary?: string;
  design?: string;
  sample?: string;
}
const { kind, title, highlight, cover, design = "s1", sample = "post" } = Astro.props;
const size = fitSize(title, { w: 600, h: 196 }, { highlight, max: kind === "post" ? 96 : 120, lh: 1 });
---

<OgFrame label={`Cover stage design, 1200 by 630, ${title}`} design={design} sample={sample} bg="#fff">
  <div class="art"><OgArt kind={kind} cover={cover} mode="bleed" /></div>
  {
    kind !== "home" && (
      <div class="chip">
        <OgIdentity avatar={56} ring={4} name={28} />
      </div>
    )
  }
  <div class="band"></div>
  <div class="head"><OgTitle text={title} highlight={highlight} size={size} lh={1} /></div>
</OgFrame>

<style>
  .art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 368px;
    overflow: hidden;
  }
  .chip {
    position: absolute;
    left: 300px;
    top: 28px;
    padding: 8px 22px 8px 8px;
    border: 4px solid #0a0a0a;
    border-radius: 999px;
    background: #fff;
    box-shadow: 6px 6px 0 #0a0a0a;
  }
  .band {
    position: absolute;
    left: 0;
    right: 0;
    top: 360px;
    bottom: 0;
    background: #1f3fd1;
    border-top: 8px solid #0a0a0a;
  }
  .head {
    position: absolute;
    left: 300px;
    width: 600px;
    top: 386px;
    height: 224px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    --hl-bg: #ffd400;
    --hl-ink: #0a0a0a;
    --hl-size: 100% 100%;
    --hl-pos: 0 0;
  }
</style>
