---
/** One social image: picks the design component for a design id and draws it from a sample. */
import ArticleBlack from "./ArticleBlack.astro";
import HomeSplit from "./HomeSplit.astro";
import PageBand from "./PageBand.astro";
import type { Sample } from "../../lib/social";

interface Props {
  design: string;
  sample: Sample;
}
const { design, sample } = Astro.props;
// design id -> component and its options
const designs: Record<string, [any, Record<string, unknown>]> = {
  a1: [ArticleBlack, { variant: "base" }],
  a1t1: [ArticleBlack, { variant: "t1" }],
  a1t2: [ArticleBlack, { variant: "t2" }],
  a1t3: [ArticleBlack, { variant: "t3" }],
  h1: [HomeSplit, {}],
  hx1: [HomeSplit, { sticker: true }],
  hx2: [HomeSplit, { ticker: true }],
  hx3: [HomeSplit, { sticker: true, ticker: true }],
  p1: [PageBand, {}],
};
const entry = designs[design];
if (!entry) throw new Error(`Unknown design: ${design}`);
const [Design, options] = entry;
---

<Design s={sample} design={design} {...options} />
