---
/** One social image: picks the design component for a design id and draws it from a sample. */
import ArticleBlack from "./ArticleBlack.astro";
import ArticleCover from "./ArticleCover.astro";
import ArticleTldr from "./ArticleTldr.astro";
import ArticleYellow from "./ArticleYellow.astro";
import HomeSplit from "./HomeSplit.astro";
import HomeCobalt from "./HomeCobalt.astro";
import HomeTicker from "./HomeTicker.astro";
import HomeStack from "./HomeStack.astro";
import PageBand from "./PageBand.astro";
import type { Sample } from "../../lib/social";

interface Props {
  design: string;
  sample: Sample;
}
const { design, sample } = Astro.props;
const designs: Record<string, typeof ArticleBlack> = {
  a1: ArticleBlack,
  a2: ArticleCover,
  a3: ArticleTldr,
  a4: ArticleYellow,
  h1: HomeSplit,
  h2: HomeCobalt,
  h3: HomeTicker,
  h4: HomeStack,
  p1: PageBand,
};
const Design = designs[design];
if (!Design) throw new Error(`Unknown design: ${design}`);
---

<Design s={sample} design={design} />
