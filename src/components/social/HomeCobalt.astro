---
/**
 * H-2 Cobalt hero. The cobalt half of the homepage hero at full size: giant white name, a tiny avatar with the Dublin tag, the tagline with a highlighter block,
 * and a tilted yellow "13+ years" sticker on the edge (cut by a square crop, which is fine).
 */
import OgFrame from "./OgFrame.astro";
import OgTitle from "./OgTitle.astro";
import OgIdentity from "./OgIdentity.astro";
import OgMarked from "./OgMarked.astro";
import { fitSize, plain, HOME, type Sample } from "../../lib/social";

interface Props {
  s: Sample;
  design: string;
}
const { s, design } = Astro.props;
const size = fitSize(plain(s.title), { w: 600, h: 372 }, { max: 230, lh: 0.92 });
---

<OgFrame label={`Cobalt hero design, 1200 by 630, ${plain(s.title)}`} design={design} sample={s.id} bg="#1f3fd1">
  <span class="tex tex-dots-c"></span>
  <div class="sticker" aria-hidden="true"><b>13+</b><i>years</i></div>
  <div class="who">
    <OgIdentity avatar={64} ring={4} />
    <span class="chip tag">{HOME.location}</span>
  </div>
  <div class="nm"><OgTitle text={s.title} size={size} lh={0.92} marks={false} /></div>
  <p class="tag-line" data-t="summary"><OgMarked text={s.summaryShort} /></p>
</OgFrame>

<style>
  .sticker {
    position: absolute;
    left: 950px;
    top: 120px;
    width: 190px;
    padding: 14px 10px 16px;
    border: 5px solid #0a0a0a;
    background: #ffd400;
    color: #0a0a0a;
    box-shadow: 10px 10px 0 #0a0a0a;
    transform: rotate(7deg);
    text-align: center;
    z-index: 2;
  }
  .sticker b {
    display: block;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "opsz" 144;
    font-size: 84px;
    line-height: 0.95;
  }
  .sticker i {
    display: block;
    font-family: var(--font-mono);
    font-style: normal;
    font-weight: 700;
    font-size: 26px;
  }
  .who {
    position: absolute;
    left: 300px;
    top: 24px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    --id-ring: #fff;
  }
  .tag {
    font-size: 22px;
    transform: rotate(4deg);
    box-shadow: 4px 4px 0 #0a0a0a;
  }
  .nm {
    position: absolute;
    left: 300px;
    width: 600px;
    top: 100px;
    height: 372px;
    z-index: 2;
    color: #fff;
    --mk-bg: #ffd400;
    --mk-ink: #0a0a0a;
  }
  .tag-line {
    position: absolute;
    left: 300px;
    width: 600px;
    top: 504px;
    z-index: 2;
    margin: 0;
    color: #fff;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 27px;
    line-height: 1.3;
    --mk-bg: #ffd400;
    --mk-ink: #0a0a0a;
  }
</style>
