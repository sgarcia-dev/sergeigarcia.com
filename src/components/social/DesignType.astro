---
/**
 * S-5 Type only. Black, a white serif title, one yellow block on the key words, the name in small
 * mono type. No picture and no avatar: the name line is the identity. Centered in the middle
 * column, so square and 2:1 crops both keep it whole.
 */
import type { ImageMetadata } from "astro";
import OgFrame from "./OgFrame.astro";
import OgTitle from "./OgTitle.astro";
import { fitSize, type Kind } from "../../lib/social";

interface Props {
  kind: Kind;
  title: string;
  highlight?: string;
  cover?: ImageMetadata;
  summary?: string;
  design?: string;
  sample?: string;
}
const { kind, title, highlight, summary = "", design = "s5", sample = "post" } = Astro.props;
const home = kind === "home";
const size = fitSize(title, { w: 600, h: 360 }, { highlight, max: 112, lh: 1.02 });
---

<OgFrame label={`Type only design, 1200 by 630, ${title}`} design={design} sample={sample} bg="#0a0a0a">
  <span class="bar bar-l"></span>
  <span class="bar bar-r"></span>
  <div class="head"><OgTitle text={title} highlight={highlight} size={size} lh={1.02} /></div>
  <div class="who">
    {
      home ? (
        <p class="tag" data-t="sub">{summary}</p>
      ) : (
        <p class="line"><span data-t="name">Sergei Garcia</span><span class="dot" aria-hidden="true"></span><span data-t="site">sergeigarcia.com</span></p>
      )
    }
  </div>
</OgFrame>

<style>
  .bar {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 40px;
    background: #ffd400;
  }
  .bar-l {
    left: 0;
  }
  .bar-r {
    right: 0;
  }
  .head {
    position: absolute;
    left: 300px;
    width: 600px;
    top: 60px;
    height: 390px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    --hl-bg: #ffd400;
    --hl-ink: #0a0a0a;
    --hl-size: 100% 100%;
    --hl-pos: 0 0;
  }
  .who {
    position: absolute;
    left: 300px;
    width: 600px;
    top: 486px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
  }
  .line,
  .tag {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 26px;
    line-height: 1.2;
    text-wrap: balance;
  }
  .line {
    display: flex;
    align-items: center;
    gap: 14px;
    white-space: nowrap;
  }
  .dot {
    width: 10px;
    height: 10px;
    background: #ffd400;
  }
  .tag {
    font-size: 28px;
  }
</style>
