---
/**
 * H-1 Hero split. The homepage hero as an image: a yellow and a cobalt half with the site's dots
 * and a thick seam exactly in the middle, a giant name that changes color where it crosses the
 * seam (black on yellow, white on cobalt), a tiny avatar with the Dublin tag, the tagline on a
 * black label. The name and label sit in the middle 600px, so any crop keeps them.
 */
import OgFrame from "./OgFrame.astro";
import OgTitle from "./OgTitle.astro";
import OgIdentity from "./OgIdentity.astro";
import OgMarked from "./OgMarked.astro";
import { fitSize, plain, HOME, type Sample } from "../../lib/social";

interface Props {
  s: Sample;
  design: string;
}
const { s, design } = Astro.props;
const size = fitSize(plain(s.title), { w: 600, h: 372 }, { max: 230, lh: 0.92 });
---

<OgFrame label={`Hero split design, 1200 by 630, ${plain(s.title)}`} design={design} sample={s.id} bg="#ffd400">
  <span class="tex tex-dots-y" style="right:600px"></span>
  <span class="tex tex-dots-c" style="left:600px"></span>
  <span class="seam"></span>
  <div class="who">
    <OgIdentity avatar={64} ring={4} />
    <span class="chip tag">{HOME.location}</span>
  </div>
  <div class="nm"><OgTitle text={s.title} size={size} lh={0.92} marks={false} /></div>
  <div class="nm ov" aria-hidden="true"><OgTitle text={s.title} size={size} lh={0.92} marks={false} role={null} /></div>
  <p class="tag-line" data-t="summary"><OgMarked text={s.summaryShort} /></p>
</OgFrame>

<style>
  .seam {
    position: absolute;
    left: 597px;
    top: 0;
    bottom: 0;
    width: 6px;
    background: #0a0a0a;
    z-index: 1;
  }
  .who {
    position: absolute;
    left: 300px;
    top: 24px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .tag {
    font-size: 22px;
    transform: rotate(4deg);
    box-shadow: 4px 4px 0 #0a0a0a;
  }
  .nm {
    position: absolute;
    left: 300px;
    width: 600px;
    top: 100px;
    height: 372px;
    z-index: 2;
    color: #0a0a0a;
  }
  .ov {
    color: #fff;
    clip-path: inset(0 0 0 300px);
  }
  .tag-line {
    position: absolute;
    left: 300px;
    width: 600px;
    top: 496px;
    z-index: 3;
    margin: 0;
    padding: 12px 20px 14px;
    background: #0a0a0a;
    color: #fff;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 26px;
    line-height: 1.25;
    --mk-bg: #ffd400;
    --mk-ink: #0a0a0a;
  }
</style>
