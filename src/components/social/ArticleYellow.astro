---
/**
 * A-4 Yellow sticker. Yellow dots like the homepage, a black title with a cobalt highlighter block,
 * avatar and name, a tilted "Writing" label and the cover on the right edge. Title and name are
 * centered; the label is part of the middle column, the cover is not.
 */
import OgFrame from "./OgFrame.astro";
import OgTitle from "./OgTitle.astro";
import OgIdentity from "./OgIdentity.astro";
import OgCover from "./OgCover.astro";
import { fitSize, plain, type Sample } from "../../lib/social";

interface Props {
  s: Sample;
  design: string;
}
const { s, design } = Astro.props;
const size = fitSize(s.titleShort, { w: 600, h: 290 }, { max: 108, lh: 1 });
---

<OgFrame label={`Yellow sticker design, 1200 by 630, ${plain(s.titleShort)}`} design={design} sample={s.id} bg="#ffd400">
  <span class="tex tex-dots-y"></span>
  {s.cover && <OgCover src={s.cover} w={250} left={944} top={250} rot={6} border={5} shadow={10} />}
  <span class="chip tag">Writing</span>
  <div class="head"><OgTitle text={s.titleShort} size={size} lh={1} /></div>
  <div class="who"><OgIdentity avatar={84} ring={5} name={36} site={26} /></div>
</OgFrame>

<style>
  .tag {
    position: absolute;
    left: 300px;
    top: 36px;
    font-size: 26px;
    transform: rotate(-4deg);
    box-shadow: 5px 5px 0 #0a0a0a;
    z-index: 1;
  }
  .head {
    position: absolute;
    left: 300px;
    width: 600px;
    top: 100px;
    height: 330px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #0a0a0a;
    z-index: 1;
    --mk-bg: #1f3fd1;
    --mk-ink: #fff;
  }
  .who {
    position: absolute;
    left: 300px;
    width: 600px;
    top: 470px;
    display: flex;
    justify-content: center;
    z-index: 1;
    --id-ink: #0a0a0a;
    --id-site: #1f3fd1;
  }
</style>
