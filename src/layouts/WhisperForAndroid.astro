---
/**
 * Standalone layout for /whisper-for-android/ (home, privacy, terms).
 * It does not use the personal site's layout, header, footer or scripts.
 * The app name and contact email come from src/lib/whisperApp.ts, the single constant.
 * No external scripts, no tracking. Dark by default, light by prefers-color-scheme.
 * Headings use the self-hosted Space Grotesk file the site already ships.
 */
import { WHISPER } from "../lib/whisperApp";
import spaceUrl from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";

interface Props {
  /** Page title. The app name is appended unless `fullTitle` is set. */
  title: string;
  description: string;
  fullTitle?: boolean;
}

const { title, description, fullTitle = false } = Astro.props;
const { name, contactEmail, base } = WHISPER;
const pageTitle = fullTitle ? title : `${title} | ${name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}icon-512.png`, Astro.site);
const fontFace = `@font-face{font-family:"WfaDisplay";font-style:normal;font-display:swap;font-weight:300 700;src:url("${spaceUrl}") format("woff2")}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#070b09" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3f8f5" media="(prefers-color-scheme: light)" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}icon.svg`} />
    <link rel="icon" type="image/png" sizes="64x64" href={`${base}favicon-64.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preload" href={spaceUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFace}></style>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="mesh" aria-hidden="true"></div>
    <header class="top">
      <a class="brand" href={base} aria-label={`${name}, home`}>
        <img class="mark" src={`${base}icon-192.webp`} width="36" height="36" alt="" />
        <span class="word">{name}</span>
      </a>
      <a class="top-cta" href={`${base}#beta`}>Get access</a>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <nav aria-label="Legal">
        <a href={`${base}privacy/`}>Privacy</a>
        <a href={`${base}terms/`}>Terms</a>
        <a href={`mailto:${contactEmail}`}>Contact</a>
      </nav>
      <p>Beta. Invite only.</p>
    </footer>

    <script>
      // Scroll reveals, plus a small parallax and tilt on phone frames. No libraries.
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const reveals = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (reduce || !("IntersectionObserver" in window)) {
        reveals.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -6% 0px" },
        );
        reveals.forEach((el) => io.observe(el));

        const phones = Array.from(document.querySelectorAll<HTMLElement>("[data-tilt]"));
        const state = new Map<HTMLElement, { sx: number; sy: number; px: number; py: number }>();
        phones.forEach((el) => state.set(el, { sx: 0, sy: 0, px: 0, py: 0 }));
        const paint = (el: HTMLElement) => {
          const s = state.get(el)!;
          el.style.setProperty("--rx", `${(s.sx + s.px).toFixed(2)}deg`);
          el.style.setProperty("--ry", `${s.py.toFixed(2)}deg`);
          el.style.setProperty("--ty", `${s.sy.toFixed(1)}px`);
        };
        let ticking = false;
        const onScroll = () => {
          ticking = false;
          const vh = innerHeight;
          for (const el of phones) {
            const r = el.getBoundingClientRect();
            if (r.bottom < -100 || r.top > vh + 100) continue;
            const p = Math.max(-1, Math.min(1, (r.top + r.height / 2 - vh / 2) / vh));
            const s = state.get(el)!;
            s.sy = p * -22;
            s.sx = p * 4;
            paint(el);
          }
        };
        addEventListener(
          "scroll",
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(onScroll);
            }
          },
          { passive: true },
        );
        addEventListener("resize", onScroll);
        onScroll();

        if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
          for (const el of phones) {
            el.addEventListener("pointermove", (ev) => {
              const r = el.getBoundingClientRect();
              const x = (ev.clientX - r.left) / r.width - 0.5;
              const y = (ev.clientY - r.top) / r.height - 0.5;
              const s = state.get(el)!;
              s.py = x * 12;
              s.px = y * -8;
              paint(el);
            });
            el.addEventListener("pointerleave", () => {
              const s = state.get(el)!;
              s.py = 0;
              s.px = 0;
              paint(el);
            });
          }
        }
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #070b09;
    --surface: rgb(255 255 255 / 0.045);
    --surface-2: rgb(255 255 255 / 0.08);
    --ink: #eef5f1;
    --muted: #aebdb4;
    --line: rgb(255 255 255 / 0.12);
    --green: #94d4b1;
    --red: #b3261e;
    --red-ink: #ff8a80;
    --blue: #8ab4f8;
    --violet: #d0bcff;
    --on: #06130c;
    --link: #94d4b1;
    --mesh-a: 0.2;
    --mesh-b: 0.14;
    --shadow: 0 40px 80px -24px rgb(0 0 0 / 0.75);
    --font: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --display: "WfaDisplay", var(--font);
  }
  @media (prefers-color-scheme: light) {
    :root {
      color-scheme: light;
      --bg: #f3f8f5;
      --surface: rgb(255 255 255 / 0.75);
      --surface-2: rgb(255 255 255 / 0.95);
      --ink: #101b16;
      --muted: #44564c;
      --line: rgb(16 40 28 / 0.14);
      --green: #1d6a47;
      --red: #b3261e;
      --red-ink: #b3261e;
      --blue: #1a5ab0;
      --violet: #5e3fa3;
      --on: #ffffff;
      --link: #1d6a47;
      --mesh-a: 0.16;
      --mesh-b: 0.1;
      --shadow: 0 30px 60px -24px rgb(20 40 30 / 0.35);
    }
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    scroll-behavior: smooth;
    background: var(--bg);
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font);
    font-size: 1rem;
    line-height: 1.6;
    overflow-x: hidden;
    position: relative;
    isolation: isolate;
  }
  /* Gradient mesh: brand green, blue, violet, and a touch of red. Fixed, never intercepts taps. */
  .mesh {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(60rem 38rem at 8% -6%, rgb(148 212 177 / var(--mesh-a)), transparent 60%),
      radial-gradient(52rem 40rem at 100% 22%, rgb(138 180 248 / var(--mesh-b)), transparent 62%),
      radial-gradient(56rem 40rem at -6% 62%, rgb(208 188 255 / var(--mesh-b)), transparent 62%),
      radial-gradient(40rem 30rem at 96% 100%, rgb(179 38 30 / 0.12), transparent 62%),
      var(--bg);
  }
  a {
    color: var(--link);
    text-underline-offset: 0.18em;
  }
  a:focus-visible,
  button:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
    border-radius: 6px;
  }
  .skip {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--bg);
    color: var(--ink);
    padding: 0.5rem 1rem;
    z-index: 10;
  }
  .skip:focus {
    left: 0.5rem;
    top: 0.5rem;
  }

  /* Header and brand */
  .top {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.9rem 1.25rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--display);
    font-weight: 600;
    letter-spacing: -0.01em;
    min-height: 44px;
  }
  .mark {
    flex: none;
    border-radius: 10px;
    box-shadow: 0 0 0 1px var(--line), 0 6px 18px -4px rgb(42 154 105 / 0.5);
  }
  .word {
    font-size: 1rem;
    white-space: nowrap;
  }
  .top-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    white-space: nowrap;
  }
  .top-cta:hover {
    border-color: var(--green);
  }

  main {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.25rem 3rem;
  }

  /* Footer */
  .foot {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 2.5rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .foot nav {
    display: flex;
    gap: 0.25rem 1.25rem;
    flex-wrap: wrap;
  }
  .foot a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .foot p {
    margin: 0;
    display: flex;
    align-items: center;
  }

  /* Privacy and terms text */
  .doc {
    max-width: 44rem;
    padding-top: 1.5rem;
  }
  .doc h1 {
    font-family: var(--display);
    font-size: clamp(2.2rem, 8vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0.5rem 0 0.75rem;
  }
  .doc .lede {
    color: var(--muted);
    font-size: 1.1rem;
    margin: 0 0 1.5rem;
  }
  .doc h2 {
    font-family: var(--display);
    font-size: 1.35rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 2rem 0 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .doc p,
  .doc li {
    overflow-wrap: anywhere;
  }
  .doc ul {
    padding-left: 1.25rem;
  }
  .doc li {
    margin: 0.35rem 0;
  }
  .doc table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.95rem;
    display: block;
    overflow-x: auto;
  }
  .doc th,
  .doc td {
    text-align: left;
    vertical-align: top;
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--line);
  }
  .doc th {
    color: var(--muted);
    font-weight: 600;
  }
  .doc .muted {
    color: var(--muted);
  }
</style>
