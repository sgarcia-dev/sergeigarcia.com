---
/**
 * Standalone layout for /whisper-for-android/ (home, privacy, terms).
 * It does not use the personal site's layout, header, footer or scripts.
 * The app name and contact email come from src/lib/whisperApp.ts, the single constant.
 * No external scripts, no tracking. Uses the app's dark mint palette.
 * Headings use the self-hosted Space Grotesk file the site already ships.
 */
import { WHISPER } from "../lib/whisperApp";
import spaceUrl from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";

interface Props {
  /** Page title. The app name is appended unless `fullTitle` is set. */
  title: string;
  description: string;
  fullTitle?: boolean;
}

const { title, description, fullTitle = false } = Astro.props;
const { name, contactEmail, base } = WHISPER;
const pageTitle = fullTitle ? title : `${title} | ${name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}icon-512.png`, Astro.site);
const fontFace = `@font-face{font-family:"WfaDisplay";font-style:normal;font-display:swap;font-weight:300 700;src:url("${spaceUrl}") format("woff2")}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0f1511" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}icon.svg`} />
    <link rel="icon" type="image/png" sizes="64x64" href={`${base}favicon-64.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preload" href={spaceUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFace}></style>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <a class="brand" href={base} aria-label={`${name}, home`}>
        <img class="mark" src={`${base}icon-192.webp`} width="36" height="36" alt="" />
        <span class="word">{name}</span>
      </a>
      <a class="top-cta" href={`${base}#beta`}>Ask for an invite</a>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <nav aria-label="Legal">
        <a href={`${base}privacy/`}>Privacy</a>
        <a href={`${base}terms/`}>Terms</a>
        <a href={`mailto:${contactEmail}`}>Contact</a>
      </nav>
      <p>Private beta. Invite only.</p>
    </footer>

  </body>
</html>

<style is:global>
  /* This independent product palette follows the app's Material 3 mint roles. */
  :root {
    color-scheme: dark;
    --bg: #0f1511;
    --surface: #181d1a;
    --surface-2: #262b28;
    --ink: #eef3ee;
    --muted: #bdc9c2;
    --line: #3f4943;
    --green: #94d4b1;
    --red: #b3261e;
    --red-ink: #ffb4ab;
    --blue: #9eccec;
    --violet: #c0c3f4;
    --on: #013822;
    --link: #aff1cc;
    --shadow: 0 24px 64px -24px rgb(0 0 0 / 0.6);
    --font: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --display: "WfaDisplay", var(--font);
    --ease: cubic-bezier(0.2, 0, 0, 1);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    background: var(--bg);
    scroll-padding-top: 2rem;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font);
    font-size: 1rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background: var(--green); color: var(--on); }
  a { color: var(--link); text-underline-offset: 0.22em; }
  a:focus-visible, button:focus-visible, summary:focus-visible {
    outline: 3px solid var(--green);
    outline-offset: 5px;
  }
  .skip {
    position: absolute;
    left: 1rem;
    top: 0;
    translate: 0 -150%;
    padding: 0.65rem 1rem;
    border-radius: 0 0 1rem 1rem;
    background: var(--green);
    color: var(--on);
    z-index: 10;
  }
  .skip:focus { translate: 0 0; }
  .top {
    max-width: 80rem;
    margin: 0 auto;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--display);
    font-weight: 500;
    letter-spacing: -0.035em;
    min-height: 44px;
    min-width: 0;
  }
  .mark { flex: none; border-radius: 11px; }
  .word { font-size: 1.05rem; white-space: nowrap; }
  .top-cta {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 44px;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--green);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .top-cta:hover { background: var(--green); color: var(--on); }
  main { max-width: 80rem; margin: 0 auto; padding: 0 1.5rem 4rem; }
  .foot {
    max-width: 77rem;
    margin: 0 auto;
    padding: 1.5rem 0 2.5rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 2rem;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .foot nav { display: flex; gap: 0.25rem 1.75rem; flex-wrap: wrap; }
  .foot a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
  }
  .foot a:hover { color: var(--green); }
  .foot p { margin: 0; }

  /* Legal pages share the same tonal surfaces, with a quieter reading measure. */
  .doc {
    max-width: 54rem;
    margin: 3rem auto 1rem;
    padding: clamp(1.5rem, 5vw, 4rem);
    background: var(--surface);
    border-radius: 2.5rem;
  }
  .doc h1 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.055em;
    margin: 0 0 1.25rem;
  }
  .doc .lede { color: var(--muted); font-size: 1rem; margin: 0 0 3rem; }
  .doc h2 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.35rem, 3vw, 1.65rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
    margin: 2.5rem 0 0.9rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .doc p, .doc li { overflow-wrap: anywhere; }
  .doc p { color: var(--muted); }
  .doc strong { color: var(--ink); font-weight: 600; }
  .doc ul { padding-left: 1.25rem; color: var(--muted); }
  .doc li { padding-left: 0.25rem; margin: 0.65rem 0; }
  .doc li::marker { color: var(--green); }
  .doc table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.95rem;
    display: block;
    overflow-x: auto;
  }
  .doc th, .doc td {
    text-align: left;
    vertical-align: top;
    padding: 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  .doc th { color: var(--ink); font-weight: 600; }
  .doc td, .doc .muted { color: var(--muted); }
  @media (prefers-reduced-motion: no-preference) {
    html { scroll-behavior: smooth; }
    .top-cta { transition: background 240ms var(--ease), color 240ms var(--ease), border-radius 240ms var(--ease); }
    .top-cta:active { border-radius: 1rem; }
    .foot a { transition: color 180ms var(--ease); }
  }
  @media (max-width: 80rem) {
    .foot { margin-inline: 1.5rem; }
  }
  @media (max-width: 600px) {
    .top { padding: 1rem; gap: 0.5rem; }
    .brand { gap: 0.5rem; }
    .mark { width: 30px; height: 30px; border-radius: 9px; }
    .word { font-size: 0.875rem; letter-spacing: -0.04em; }
    .top-cta { padding-inline: 0.875rem; font-size: 0.8rem; }
    main { padding: 0 1rem 2.5rem; }
    .foot { margin-inline: 1rem; padding-block: 1rem 2rem; }
    .foot nav { gap: 1.25rem; }
    .doc { margin-top: 1.5rem; border-radius: 1.75rem; }
    .doc .lede { margin-bottom: 2rem; }
  }
</style>
