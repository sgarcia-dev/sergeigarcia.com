---
import "../styles/global.css";
import frauncesUrl from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../lib/site";
import LabSwitch from "../lab/LabSwitch.astro";
import "../lab/lab-bg.css";
import "../lab/lab-motion.css";
import "../lab/lab-lively.css";

interface Props {
  /** Page title. "| Sergei Garcia" is appended unless `fullTitle` is set. */
  title: string;
  description: string;
  fullTitle?: boolean;
  /** "website" by default, "article" for posts and case studies. */
  ogType?: "website" | "article" | "profile";
  /** One JSON-LD object or an array of them. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** True only on the home page: the big name owns the view-transition name there. */
  home?: boolean;
  /** Share image path (e.g. from shareImage()). Falls back to the default card. */
  ogImage?: string;
  ogImageAlt?: string;
}

const { title, description, fullTitle = false, ogType = "website", jsonLd, home = false, ogImage: ogPath, ogImageAlt } = Astro.props;
const pageTitle = fullTitle ? title : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogPath ?? SITE.ogImage, Astro.site);
const ogAlt = ogImageAlt ?? "Sergei Garcia, senior software engineer";
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <!-- Hold first paint until <main> is parsed, so a cross-document view transition
         always finds the new page's named elements instead of capturing a half-built page. -->
    <link rel="expect" href="#main" blocking="render" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Sergei Garcia" href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_IE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <LabSwitch />
    <meta name="robots" content="noindex" />
    <meta name="generator" content={Astro.generator} />
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a href="#main" class="hit skip">Skip to content</a>
    <Header home={home} />
    <main id="main" class:list={[home && "home-mono"]}>
      <slot />
    </main>
    <Footer />
    <script>import "../lab/lab-motion.ts";
      import "../lab/lab-lively.ts";</script>
  </body>
</html>
