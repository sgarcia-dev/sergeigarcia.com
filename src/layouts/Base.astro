---
import "../styles/global.css";
import frauncesUrl from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url";
import spaceUrl from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../lib/site";
import { findOgTarget, ogImagePath, ogImageExists } from "../lib/ogTargets";
import TexturePick from "../components/TexturePick.astro";
import MotionInit from "../components/MotionInit.astro";
import ThemeInit from "../components/ThemeInit.astro";
import "../styles/texture.css";
import "../styles/lively.css";
import "../styles/motion.css";
import "../styles/readtime.css";
import "../styles/theme.css";

interface Props {
  /** Page title. "| Sergei Garcia" is appended unless `fullTitle` is set. */
  title: string;
  description: string;
  fullTitle?: boolean;
  /** "website" by default, "article" for posts and case studies. */
  ogType?: "website" | "article" | "profile";
  /** One JSON-LD object or an array of them. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** True only on the home page: the big name owns the view-transition name there. */
  home?: boolean;
  /** Share image path. Pages normally leave this out: the image for the page's address comes from src/lib/ogTargets.ts (made by `npm run og`), then the default card. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Whole minutes to read the page. Only posts and case studies pass it; it turns on the "minutes left" chip. */
  readMinutes?: number;
  /** Also preload the body font. Posts pass it because body text is now visible at first paint, so a late font swap would shift it. */
  preloadBody?: boolean;
  /** Keep the page out of search engines (unlisted lab pages). Pair it with a sitemap filter in astro.config.mjs. */
  noindex?: boolean;
  /** True only on /hack/, which has its own controls, so the "Hacked" bar is left out. */
  hack?: boolean;
}

const { title, description, fullTitle = false, ogType = "website", jsonLd, home = false, ogImage: ogPath, ogImageAlt, readMinutes, preloadBody = false, noindex = false, hack = false } = Astro.props;
const pageTitle = fullTitle ? title : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Share image: an explicit prop wins, then the page's own image from public/og/, then the default card.
const target = ogPath ? undefined : await findOgTarget(Astro.url.pathname);
if (target && !ogImageExists(target.key) && !process.env.OG_BUILD) {
  console.warn(`[og] No image for ${target.path} yet (public/og/${target.key}.png). Using the default card. Run: npm run og`);
}
const pageImage = target && ogImageExists(target.key) ? ogImagePath(target.key) : undefined;
const ogImage = new URL(ogPath ?? pageImage ?? SITE.ogImage, Astro.site);
const ogAlt = ogImageAlt ?? (pageImage ? target!.alt : "Sergei Garcia, software engineer");
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    {preloadBody && <link rel="preload" href={spaceUrl} as="font" type="font/woff2" crossorigin />}
    <!-- Cross-document view transition opt-in, inline on purpose. Chrome reads this rule when the new page
         is first revealed; if it only lived in the linked stylesheet, a fast load (cached page) could reveal
         before that sheet applied, and Chrome dropped the whole transition ("opt-in disabled"). -->
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }
    </style>
    <!-- Hold first paint until <main> is parsed, so a cross-document view transition
         always finds the new page's named elements instead of capturing a half-built page. -->
    <link rel="expect" href="#main" blocking="render" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Sergei Garcia" href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_IE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <TexturePick />
    <MotionInit />
    <ThemeInit />
    <meta name="generator" content={Astro.generator} />
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a href="#main" class="hit skip">Skip to content</a>
    <Header home={home} readMinutes={readMinutes} />
    <main id="main" class:list={[home && "home-mono"]}>
      <slot />
    </main>
    <Footer />
    {
      !hack && (
        <aside class="th-bar" aria-label="Your theme">
          <span class="label th-bar-label">Hacked</span>
          <a class="hit" href="/hack/">Edit</a>
          <a class="hit" href="?theme=off">Reset</a>
        </aside>
      )
    }
    <script>
      import "../scripts/motion.ts";
      import "../scripts/lively.ts";
      import "../scripts/readtime.ts";
    </script>
  </body>
</html>
