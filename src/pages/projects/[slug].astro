---
import type { InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import CaseMeta from "../../components/CaseMeta.astro";
import Media from "../../components/Media.astro";
import Gallery from "../../components/Gallery.astro";
import { getProjects, vtName } from "../../lib/content";
import { SITE } from "../../lib/site";
import { readingMinutes } from "../../lib/readingTime";
import { AUTHOR_REF, breadcrumbs, shareImage } from "../../lib/seo";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props;
const { title, summary, company, role, period, skills, links, gallery, galleryCaption, cover, coverAlt, confidential, coverKind } =
  entry.data;
const { Content } = await render(entry);
const minutes = readingMinutes(entry.body);

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const showCover = cover && !(confidential && coverKind !== "illustration");
const ogImage = showCover ? await shareImage(cover) : undefined;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description: summary,
    author: AUTHOR_REF,
    about: company,
    keywords: skills.join(", "),
    ...(ogImage ? { image: new URL(ogImage, SITE.url).href } : {}),
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  },
  breadcrumbs([
    { name: "Projects", path: "/projects/" },
    { name: title, path: Astro.url.pathname },
  ]),
];
---

<Base title={title} description={summary} ogType="article" jsonLd={jsonLd} ogImage={ogImage} ogImageAlt={coverAlt} readMinutes={minutes}>
  <PageHead title={title} band="cobalt" vt={vtName("projects", entry.id)} progress>
    <p class="mt-md max-w-prose text-lg">{summary}</p>
    <p class="label mt-sm">{minutes} min read</p>
  </PageHead>
  <section class="edge-b">
    <div class="shell grid gap-lg py-lg lg:grid-cols-12 lg:py-xl">
      <div class="lg:col-span-4">
        <div class="meta-col">
          <CaseMeta role={role} company={company} period={period} skills={skills} links={links} />
        </div>
      </div>
      <div class="lg:col-span-8">
        <Media entry={entry} />
        <div class="prose mt-xl" data-rt-body>
          <Content />
        </div>
        {gallery.length > 0 && (
          <div class="mt-xl">
            <Gallery items={gallery} caption={galleryCaption} />
          </div>
        )}
        <p class="mt-lg"><a class="hit" href="/projects/">All projects</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  @media (min-width: 64rem) {
    .meta-col {
      position: sticky;
      /* --stick-top (motion.css) keeps it under the sticky header and page head banner. */
      top: var(--stick-top, var(--spacing-md));
    }
  }
</style>
