---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Icon from "../components/Icon.astro";
import { Picture } from "astro:assets";
import { SITE, ABOUT_BAND } from "../lib/site";
import { PERSON, breadcrumbs } from "../lib/seo";
import { PAGE_META } from "../lib/pageMeta";
import family from "../assets/about/family.jpg";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    url: `${SITE.url}/about/`,
    name: "About Sergei Garcia",
    mainEntity: PERSON,
  },
  breadcrumbs([{ name: "About", path: "/about/" }]),
];
---

<Base title={PAGE_META.about.title} description={PAGE_META.about.description} ogType="profile" jsonLd={jsonLd}>
  <PageHead band={ABOUT_BAND} title="About" />

  <div class="shell py-sm lg:py-md">
    <section class="about-section grid gap-md py-lg lg:grid-cols-12 lg:gap-md" aria-labelledby="about-bio">
      <div class="lg:col-span-5">
        <h2 id="about-bio" class="label">Hi, I'm Sergei</h2>
        <figure class="photo mt-sm">
          <Picture
            src={family}
            formats={["avif", "webp"]}
            widths={[400, 640, 960]}
            sizes="(min-width: 64rem) 28rem, 100vw"
            alt="Sergei with his wife and daughter, smiling on a lakeside hike in Ireland"
            loading="eager"
            decoding="async"
            pictureAttributes={{ class: "block" }}
          />
        </figure>
      </div>
      <div class="prose lg:col-span-7">
        <p>
          I'm from Mexico. Last year my wife, our young daughter and I packed up and moved to Dublin, Ireland for my
          work. We have been exploring the country ever since, one weekend at a time, and it already feels like home.
        </p>
        <p>
          My road into software was a <span class="lv-mark">happy accident</span>. I originally wanted to study graphic design, and my background
          is in project management, not engineering. Somewhere along the way I found out that I love building things
          even more than planning them. That was <span class="lv-mark">more than 13 years</span> ago, and I still get the same kick when something
          I made works for the first time.
        </p>
        <p>
          People usually describe me as cheerful and positive. I try to lead with <span class="lv-mark">empathy</span>, at work and at home. I
          would rather understand why someone is stuck than tell them what to do, and I think that is why teaching
          has followed me through every job.
        </p>
      </div>
    </section>

    <section class="about-section grid gap-sm py-lg lg:grid-cols-12 lg:gap-md" aria-labelledby="about-strengths">
      <h2 id="about-strengths" class="label lg:col-span-5">What I bring to a team</h2>
      <div class="prose lg:col-span-7">
        <p>
          <strong>A planner's habits.</strong> Thanks to that project management start, I think about scope,
          deadlines and the people waiting on the work, and I'm good at turning a fuzzy idea into a plan a team can
          actually ship.
        </p>
        <p>
          <strong>A designer's eye.</strong> I never stopped caring about design, so I sweat the UI and UX details:
          clear layouts, motion that helps, accessibility, and the small things people feel without naming.
        </p>
        <p>
          <strong>A teacher's patience.</strong> I have mentored developers one to one, taught bootcamp classes at
          Desafio Latam, run workshops for Thinkful students and given enterprise training. I start from what the
          person already knows, then we work through real problems together.
        </p>
        <p>
          Most of my work has been on the front end with React and TypeScript, plus full-stack work when the job
          needs it. I started in consulting, building apps for agriculture and healthcare, then worked on travel,
          education, research and social products, including Typing.com, St. Jude Children's Research Hospital
          and Reddit.
        </p>
      </div>
    </section>

    <section class="about-section grid gap-sm py-lg lg:grid-cols-12 lg:gap-md" aria-labelledby="about-life">
      <h2 id="about-life" class="label lg:col-span-5">Things I love</h2>
      <div class="prose lg:col-span-7">
        <ul>
          <li>
            <strong>Showing my daughter the world.</strong> We take every chance we get to travel somewhere new as a
            family.
          </li>
          <li>
            <strong>Taking things apart.</strong> Electronics, gadgets, new tools. If it just came out, I want to
            know how it works.
          </li>
          <li>
            <strong>Keeping up with tech and AI.</strong> I read about what's new and then try it myself, usually the
            same week.
          </li>
          <li>
            <strong>Teaching.</strong> My favorite moment is when something finally clicks for someone.
          </li>
          <li><strong>Classic rock and disco.</strong> That's most of what's on my playlists.</li>
        </ul>
      </div>
    </section>

    <section class="about-section grid gap-sm py-lg lg:grid-cols-12 lg:gap-md" aria-labelledby="about-languages">
      <h2 id="about-languages" class="label lg:col-span-5">Languages</h2>
      <div class="prose lg:col-span-7">
        <p>English and Spanish.</p>
      </div>
    </section>

    <section class="about-section grid gap-sm py-lg lg:grid-cols-12 lg:gap-md" aria-labelledby="about-contact">
      <h2 id="about-contact" class="label lg:col-span-5">Contact</h2>
      <div class="lg:col-span-7">
        <p class="prose mb-md">The best way to reach me is by email.</p>
        <ul role="list" class="flex flex-wrap gap-sm">
          <li><a class="hit hit-primary" href={`mailto:${SITE.email}`}><Icon name="email" />{SITE.email}</a></li>
          <li><a class="hit" href={SITE.links.linkedin} rel="me"><Icon name="linkedin" />LinkedIn</a></li>
          <li><a class="hit" href={SITE.links.github} rel="me"><Icon name="github" />GitHub</a></li>
          <li>
            <a class="hit" href={SITE.resume} download="Sergei Garcia - Resume.pdf"
              ><Icon name="download" />Resume (PDF)</a
            >
          </li>
        </ul>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Thin rules between about sections, in the page rule color. */
  .about-section {
    border-bottom: var(--rule-thin) solid var(--rule-color);
  }
  .about-section:last-child {
    border-bottom: 0;
  }
  /* The family photo: thick frame like the screenshots, no shadow (it is not a control). */
  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: var(--rule-thick) solid var(--edge);
  }
  @media (min-width: 64rem) {
    .photo {
      max-width: 28rem;
    }
  }
</style>
