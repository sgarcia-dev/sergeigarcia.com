---
// Name of the company for the enterprise training bullet. Leave empty until the legal check is done:
// the bullet then says "a consulting firm". Set it to a name (for example "Skiller Whale") to show it.
const TRAINING_CLIENT = "";

import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Icon from "../components/Icon.astro";
import PullQuote from "../components/PullQuote.astro";
import YouTubeEmbed from "../components/YouTubeEmbed.astro";
import { Picture } from "astro:assets";
import { SITE, ABOUT_BAND } from "../lib/site";
import { PERSON, breadcrumbs } from "../lib/seo";
import { PAGE_META } from "../lib/pageMeta";
import family from "../assets/about/family.jpg";
import thumbQueen from "../assets/about/music/Ant1VvQXsJ4.jpg";
import thumbHolst from "../assets/about/music/3aXsQQ-ueBk.jpg";
import thumbHome from "../assets/about/music/8GW6sLrK40k.jpg";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    url: `${SITE.url}/about/`,
    name: "About Sergei Garcia",
    mainEntity: PERSON,
  },
  breadcrumbs([{ name: "About", path: "/about/" }]),
];

// Quick facts under the intro: small tilted tags (the tilt comes from the pill rules in lively.css).
const facts = ["From Mexico", "Lives in Dublin", "13+ years of software", "English and Spanish", "Front end first"];

// The contact line follows the site-wide availability switch (src/lib/site.ts), never its own copy of the choice.
const availability: Record<string, string | null> = {
  looking: "I'm currently looking for my next role, so if your team is hiring, ",
  open: "Always happy to hear about interesting work in developer tools and AI. ",
  off: null,
};
const availabilityLead = availability[SITE.availability];
const trainingWhere = TRAINING_CLIENT || "a consulting firm";

// Favorite music: three songs, each with a click-to-load video (thumbnails are local files in src/assets/about/music).
const songs = [
  {
    id: "Ant1VvQXsJ4",
    thumb: thumbQueen,
    videoTitle: "Queen, Who Wants to Live Forever (Live in Budapest, 1986)",
    tag: "Rock ballad · 1986",
    title: "Who Wants to Live Forever",
    artist: "Queen",
    why: "One of the most beautiful songs I know, and I love it and hate it. It's gorgeous, and it makes me want to cry at how helpless it feels.",
    fact: "Brian May wrote most of it in the car on the way home, right after watching footage from the film Highlander.",
    extra: true,
  },
  {
    id: "3aXsQQ-ueBk",
    thumb: thumbHolst,
    videoTitle: "Holst, Jupiter, the Bringer of Jollity (NDR Radiophilharmonie, Andrew Manze)",
    tag: "Classical · 1914",
    title: "Jupiter, the Bringer of Jollity",
    artist: "Gustav Holst",
    why: "My favorite classical piece. I play it while I work, when I need a little quiet time, and on long walks.",
    fact: "Its slow, broad middle tune later became the hymn \"I Vow to Thee, My Country\".",
    extra: false,
  },
  {
    id: "8GW6sLrK40k",
    thumb: thumbHome,
    videoTitle: "HOME, Resonance",
    tag: "Synthwave · 2014",
    title: "Resonance",
    artist: "HOME",
    why: "Warm, steady synths that feel like a late night drive. It's my go-to when I need to focus and lose track of time.",
    fact: "It's track nine on HOME's 2014 album Odyssey, released on the small independent label Midwest Collective.",
    extra: false,
  },
];
---

<Base title={PAGE_META.about.title} description={PAGE_META.about.description} ogType="profile" jsonLd={jsonLd}>
  <PageHead band={ABOUT_BAND} title="Hi, I'm Sergei.">
    <p class="hook font-title mt-sm max-w-prose text-xl">
      I got into software because a <span class="lv-mark lv-mark--band">kind librarian said yes</span>.
    </p>
  </PageHead>

  <section class="shell grid gap-md py-lg lg:grid-cols-12 lg:gap-lg lg:py-xl" aria-label="Introduction">
    <div class="lg:col-span-5">
      <figure class="photo">
        <Picture
          src={family}
          formats={["avif", "webp"]}
          widths={[400, 640, 960]}
          sizes="(min-width: 64rem) 28rem, 100vw"
          alt="Sergei with his wife and daughter, smiling on a lakeside hike in Ireland"
          loading="eager"
          decoding="async"
          pictureAttributes={{ class: "block" }}
        />
      </figure>
    </div>
    <div class="lg:col-span-7">
      <div class="prose">
        <p>
          I'm a software engineer from Mexico. Last year my wife, our young daughter and I packed up and moved to
          Dublin, Ireland. We have been exploring the country ever since, one weekend at a time, and it already feels
          like home.
        </p>
        <p>
          I miss Mexican food, chilaquiles and pozole most of all, and how big the country is. In Ireland I love the
          green, how easy it is to get around by bike, and the warm, kind people.
        </p>
        <p>
          Most of my work has been on the front end with React and TypeScript, plus full stack when the job needs it.
          It's all on the <a href="/work/">work page</a>.
        </p>
      </div>
      <ul role="list" class="facts pill-list mt-md" aria-label="Quick facts">
        {facts.map((f) => <li class="pill">{f}</li>)}
      </ul>
    </div>
  </section>

  <section class="edge-t" aria-labelledby="about-start">
    <div class="shell grid gap-md py-lg lg:grid-cols-12 lg:gap-lg lg:py-xl">
      <div class="lg:col-span-5">
        <p class="label">Around 2005</p>
        <h2 id="about-start" class="sec-title font-display tracking-tight mt-xs">How I got here</h2>
      </div>
      <div class="prose lg:col-span-7">
        <p>
          I'm 13, in the school library, watching the older kids make animations and websites in Macromedia Flash and
          Dreamweaver. I want in so badly it must show on my face, because the librarian notices and
          <span class="lv-mark">offers to teach me</span>.
        </p>
        <p>
          That's the whole origin story. I made small animations, simple turn-based games and websites, and I had a
          ridiculous amount of fun.
        </p>
        <p>
          I planned to study graphic design, and my background is in project management, not engineering. Somewhere
          along the way I found out I like building even more than planning. I've been at it for
          <span class="lv-mark">more than 13 years</span> now, and I still get the same kick when something I made works
          for the first time.
        </p>
      </div>
    </div>
  </section>

  <section class="band-cobalt edge-t edge-b" aria-labelledby="about-work">
    <div class="shell py-lg lg:py-xl">
      <h2 id="about-work" class="sec-title font-display tracking-tight">How I work</h2>
      <p class="mt-xs max-w-prose text-lg">Three habits, from three different starts.</p>
      <ul role="list" class="work mt-md">
        <li class="work-row">
          <h3 class="work-title font-display tracking-tight">Planner</h3>
          <div class="work-body">
            <p>
              I started in project management, so I think about scope, deadlines and the people waiting on the work.
              Give me a fuzzy idea and I'll turn it into a plan a team can actually ship.
            </p>
            <p class="eg">
              <span class="label">For example</span>
              At Typing.com I was handed the rebuild of the whole teacher portal, the part of the site teachers use,
              with no tickets and no plan. I wrote a system design doc, then a plan with deliverables, risks and
              timelines, and kept leadership up to date with <span class="lv-mark lv-mark--band">weekly demos</span>.
            </p>
          </div>
        </li>
        <li class="work-row">
          <h3 class="work-title font-display tracking-tight">Designer</h3>
          <div class="work-body">
            <p>
              I never stopped caring about design. I sweat the details people feel without naming them: clear layouts,
              spacing, motion that helps.
            </p>
            <p class="eg">
              <span class="label">For example</span>
              At Reddit I pushed back when something didn't feel right or wasn't as polished as it should be. When the
              tech or the deadline ruled out the design as drawn, I worked with the designer on a
              <span class="lv-mark lv-mark--band">compromise that still felt finished</span>.
            </p>
          </div>
        </li>
        <li class="work-row">
          <h3 class="work-title font-display tracking-tight">Teacher</h3>
          <div class="work-body">
            <p>I would rather understand why someone is stuck than tell them what to do.</p>
            <p>
              I taught myself, and for a long time I had no mentor. That meant a lot of frustration. Later, a few great
              mentors got me unstuck, and I'm deeply grateful to them. Nothing is more rewarding than paying that
              forward.
            </p>
            <ul role="list" class="eg bullets">
              <li>Taught bootcamp classes at Desafio Latam.</li>
              <li>
                Mentored people with no coding experience at Thinkful.
                <span class="lv-mark lv-mark--band">They went on to land full-stack engineering jobs.</span>
              </li>
              <li>One-on-one mentor to a handful of people.</li>
              <li>Gave enterprise React training to engineering teams at {trainingWhere}.</li>
            </ul>
            <p>
              My favorite moment is when a hard idea finally clicks, like <code>this</code> in JavaScript or how React's
              render loop works.
            </p>
          </div>
        </li>
      </ul>
      <p class="mt-lg max-w-prose text-lg">
        The feedback I hear most is that I <span class="lv-mark lv-mark--band">make the people around me better</span>.
        I walk teammates through new tools, I help whoever is stuck, and I care about the craft enough that it rubs off.
        I plan to keep it that way.
      </p>
    </div>
  </section>

  <section class="shell grid gap-md py-lg lg:grid-cols-12 lg:gap-lg lg:py-xl" aria-labelledby="about-rule">
    <div class="lg:col-span-8 xl:col-span-7">
      <h2 id="about-rule" class="font-display text-h2 tracking-tight">My rule for the web</h2>
      <PullQuote>A website should work for everyone, on any screen.</PullQuote>
      <p class="prose">
        That includes people on entry-level phones, older laptops and screens of every shape and size. Somewhere along
        the way we got comfortable shipping bloated pages to people on MacBook Pros and flagship phones. Not everyone
        agrees with me on this. I still think the extra work is worth it.
      </p>
    </div>
  </section>

  <section class="shell pb-lg lg:pb-xl" aria-labelledby="about-now">
    <div class="now band-black">
      <p class="label tag-now">Current experiment</p>
      <h2 id="about-now" class="font-title mt-sm text-xl">Running AI agents from my phone</h2>
      <p class="mt-sm max-w-prose text-lg">
        In plain terms: I send a task from my phone, and AI agents on my laptop get it done while I'm away from my desk.
        This month I'm running them around the clock. I use Hermes Agent to hand out the tasks and keep several going in
        parallel, across OpenAI, Anthropic, Google and OpenCode models.
      </p>
      <ul role="list" class="mt-md flex flex-wrap gap-sm">
        <li>
          <a class="hit hit-primary" href="/writing/ai-raises-the-floor/"
            >Read: Everyone has the same AI now. The difference is you.</a
          >
        </li>
        <li><a class="hit" href="/playground/">Try the playground</a></li>
      </ul>
    </div>
  </section>

  <section class="edge-t" aria-labelledby="about-off">
    <div class="shell py-lg lg:py-xl">
      <p class="label">Off the clock</p>
      <h2 id="about-off" class="sec-title font-display tracking-tight mt-xs">Favorite music</h2>
      <p class="mt-sm max-w-prose text-lg">Three songs I keep coming back to. Press play if you want to listen along.</p>
      <ul role="list" class="songs mt-md">
        {
          songs.map((song) => (
            <li class="song">
              <YouTubeEmbed id={song.id} title={song.videoTitle} thumb={song.thumb} />
              <div class="song-body">
                <p class="label song-tag">{song.tag}</p>
                <h3 class="song-title font-display tracking-tight">{song.title}</h3>
                <p class="song-artist">by {song.artist}</p>
                <p class="song-why">{song.why}</p>
                <p class="song-fact">
                  <span class="fact-chip label">Fun fact</span> {song.fact}
                </p>
                {song.extra && (
                  <p class="song-extra">
                    Also worth a listen:{" "}
                    <a href="https://www.youtube.com/watch?v=oygIWCseYI0" target="_blank" rel="noopener noreferrer">
                      Andrea Bocelli singing it with Brian May<span class="new-tab"> (opens in a new tab)</span>
                    </a>{" "}
                    in 2024.
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
      <p class="mt-md max-w-prose text-muted">
        Also on repeat for decades: Michael Jackson, Journey and Linkin Park. And seeing André Rieu live with my mom is
        still one of my favorite nights.
      </p>
    </div>
  </section>

  <section class="band-yellow edge-t" aria-labelledby="about-contact">
    <div class="shell py-lg lg:py-xl">
      <h2 id="about-contact" class="font-display text-h2 tracking-tight">Say hello.</h2>
      <p class="mt-sm max-w-prose text-lg">
        Email is the best way to reach me.{" "}
        {
          availabilityLead && (
            <>
              {availabilityLead}
              <span class="lv-mark lv-mark--band">let's talk</span>.
            </>
          )
        }
      </p>
      <ul role="list" class="mt-md flex flex-wrap gap-sm">
        <li><a class="hit hit-primary" href={`mailto:${SITE.email}`}><Icon name="email" />{SITE.email}</a></li>
        <li><a class="hit" href={SITE.links.linkedin} rel="me"><Icon name="linkedin" />LinkedIn</a></li>
        <li><a class="hit" href={SITE.links.github} rel="me"><Icon name="github" />GitHub</a></li>
        <li>
          <a class="hit" href={SITE.resume} download="Sergei Garcia - Resume.pdf"
            ><Icon name="download" />Resume (PDF)</a
          >
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Section headings on this page: display serif, a notch under the big page heading. */
  .sec-title {
    font-size: clamp(2.25rem, 1.2rem + 4.2vw, 3.75rem);
    line-height: 1;
  }
  /* The hook sits in the title band; the bar must not outgrow the band's text. */
  .hook {
    line-height: 1.2;
  }
  /* The family photo: thick frame like the screenshots, no shadow (it is not a control). */
  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: var(--rule-thick) solid var(--edge);
  }
  @media (min-width: 64rem) {
    .photo {
      max-width: 28rem;
    }
  }
  /* Quick facts: the pills sit a little crooked, like stickers. Hover keeps the pop from lively.css. */
  .facts {
    gap: var(--spacing-xs) var(--spacing-sm);
  }
  .facts .pill {
    padding: var(--spacing-2xs) var(--spacing-sm);
    font-weight: var(--font-weight-medium);
  }
  .facts .pill:not(:hover) {
    transform: rotate(calc(var(--lv-tilt) * 0.7));
  }
  /* How I work: three full-width rows on the cobalt band. Title on the left, text on the right on wide screens;
     stacked on phones. Each row is closed by a thick rule in the band's rule color. */
  .work-row {
    display: grid;
    gap: var(--spacing-sm);
    padding-block: var(--spacing-md);
    border-top: var(--rule-thick) solid var(--rule-color);
  }
  .work-row:last-child {
    border-bottom: var(--rule-thick) solid var(--rule-color);
  }
  .work-title {
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.5rem);
    line-height: 1.05;
  }
  .work-body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    max-width: 44rem;
  }
  @media (min-width: 64rem) {
    .work-row {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: var(--spacing-lg);
      padding-block: var(--spacing-lg);
    }
  }
  /* The example (or the list of places) sits inset with a thick bar on the left. */
  .eg {
    padding-left: var(--spacing-sm);
    border-left: var(--rule-thick) solid var(--rule-color);
    font-size: var(--text-base);
  }
  .eg .label {
    display: block;
    margin-bottom: var(--spacing-2xs);
  }
  .bullets {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }
  .bullets li {
    position: relative;
    padding-left: var(--spacing-sm);
  }
  .bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.4rem;
    height: 0.4rem;
    background: currentColor;
  }
  .work code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    padding: 0 0.25em;
    background: var(--color-black);
    color: var(--color-white);
  }

  /* Favorite music: three song cards. One column on phones, a video-left card on tablets, three columns on wide
     screens. Same language as the rest of the page: thick ink border, hard shadow, yellow chip. */
  .songs {
    display: grid;
    gap: var(--spacing-md);
    padding-right: 8px; /* room for the hard shadow so it never causes sideways scroll */
    padding-bottom: 8px;
  }
  .song {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: var(--color-bg);
    border: var(--rule-thick) solid var(--edge);
    box-shadow: 6px 6px 0 var(--edge);
  }
  /* The embed brings its own frame; inside a card the card's frame is enough. */
  .song :global(.yt) {
    max-width: none;
    margin: 0;
    border: 0;
    border-bottom: var(--rule-thick) solid var(--edge);
    box-shadow: none;
  }
  /* The ring goes around the whole card, so it stays visible on dark thumbnails in both color schemes. */
  .song :global(.yt:has(.yt-play:focus-visible)) {
    outline: none;
  }
  .song:has(.yt-play:focus-visible),
  .song:has(.song-extra a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }
  .song-body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    padding: var(--spacing-md);
  }
  .song-tag {
    color: var(--color-muted);
  }
  .song-title {
    font-size: clamp(1.5rem, 1.2rem + 1.1vw, 1.875rem);
    line-height: 1.1;
    text-wrap: balance;
  }
  .song-artist {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    margin-top: calc(var(--spacing-2xs) * -1);
  }
  .song-why {
    margin-top: var(--spacing-2xs);
  }
  /* The aside: a yellow chip label, then a smaller line of text. */
  .song-fact {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-muted);
    padding-left: var(--spacing-xs);
    border-left: var(--rule-thick) solid var(--edge);
  }
  .fact-chip {
    display: inline-block;
    background: var(--color-yellow);
    color: var(--color-black);
    padding: 0 var(--spacing-xs);
    margin-right: var(--spacing-2xs);
  }
  .song-extra {
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .new-tab {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (min-width: 48rem) {
    .songs {
      gap: var(--spacing-lg);
    }
    .song {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    /* The video column grows to the height of the text, and the picture covers it. */
    .song :global(.yt) {
      aspect-ratio: auto;
      min-height: 12rem;
      border-bottom: 0;
      border-right: var(--rule-thick) solid var(--edge);
    }
    .song :global(.yt-link) {
      position: absolute;
      inset: 0;
    }
  }
  @media (min-width: 75rem) {
    .songs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--spacing-md);
    }
    .song {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr;
    }
    .song :global(.yt-link) {
      position: static;
    }
    .song :global(.yt) {
      aspect-ratio: 16 / 9;
      min-height: 0;
      border-right: 0;
      border-bottom: var(--rule-thick) solid var(--edge);
    }
    .song-fact {
      margin-top: auto;
    }
    .song-why {
      margin-bottom: var(--spacing-xs);
    }
  }
  /* Hover and focus: the card lifts and its shadow grows, the opposite of the buttons pressing in. */
  @media (prefers-reduced-motion: no-preference) {
    .song {
      transition:
        transform var(--duration-page) var(--ease-out),
        box-shadow var(--duration-page) var(--ease-out);
    }
    .song:hover,
    .song:has(.yt-play:focus-visible) {
      transform: translate(-2px, -2px);
      box-shadow: 9px 9px 0 var(--edge);
    }
  }
  /* Right now: a black box with a thick edge. Black in light mode, and the chalk edge keeps it visible in dark mode. */
  .now {
    border: var(--rule-thick) solid var(--color-chalk);
    padding: var(--spacing-md);
  }
  @media (min-width: 48rem) {
    .now {
      padding: var(--spacing-lg);
    }
  }
  .tag-now {
    display: inline-block;
    background: var(--color-yellow);
    color: var(--color-black);
    padding: 0 var(--spacing-xs);
  }
</style>
