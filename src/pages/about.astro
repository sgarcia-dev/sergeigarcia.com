---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Icon from "../components/Icon.astro";
import { Picture } from "astro:assets";
import { SITE } from "../lib/site";
import family from "../assets/about/family.jpg";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: `${SITE.url}/about/`,
  name: "About Sergei Garcia",
  mainEntity: {
    "@type": "Person",
    name: SITE.name,
    jobTitle: SITE.jobTitle,
    url: SITE.url,
    email: `mailto:${SITE.email}`,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Dublin",
      addressCountry: "IE",
    },
    knowsLanguage: ["en", "es"],
    sameAs: [SITE.links.linkedin, SITE.links.github],
  },
};
---

<Base
  title="About"
  description="About Sergei Garcia, a software engineer from Mexico living in Dublin, Ireland. 13+ years building web products, a designer's eye, and a love of teaching."
  ogType="profile"
  jsonLd={jsonLd}
>
  <PageHead band="cobalt" title="About" />

  <div class="shell py-sm lg:py-md">
    <section class="about-section grid gap-md py-lg lg:grid-cols-12 lg:gap-md" aria-labelledby="about-bio">
      <div class="lg:col-span-5">
        <h2 id="about-bio" class="label">Hi, I'm Sergei</h2>
        <figure class="photo mt-sm">
          <Picture
            src={family}
            formats={["avif", "webp"]}
            widths={[400, 640, 960]}
            sizes="(min-width: 64rem) 28rem, 100vw"
            alt="Sergei with his wife and daughter, smiling on a lakeside hike in Ireland"
            loading="eager"
            decoding="async"
            pictureAttributes={{ class: "block" }}
          />
          <figcaption class="label mt-xs">With my wife and daughter, out exploring Ireland.</figcaption>
        </figure>
      </div>
      <div class="prose lg:col-span-7">
        <p>
          I'm a software engineer from Mexico. Last year my family and I moved to Dublin, Ireland for work, and we love
          it here. I have been building software for more than 13 years, mostly on the front end with React and
          TypeScript, and across the full stack when the work needs it.
        </p>
        <p>
          I started in consulting, building apps for agriculture and healthcare. Since then I have worked on travel,
          education, research and social products. At Typing.com I led the move of the front end to React. Through
          Toptal I built interfaces for St. Jude Children's Research Hospital and Northeastern University. At Reddit I
          worked on how translated posts are shown to people around the world.
        </p>
      </div>
    </section>

    <section class="about-section grid gap-sm py-lg lg:grid-cols-12 lg:gap-md" aria-labelledby="about-strengths">
      <h2 id="about-strengths" class="label lg:col-span-5">What I bring</h2>
      <div class="prose lg:col-span-7">
        <p>
          <strong>A project manager's habits.</strong> I studied project management before I ever wrote code
          professionally. That happy accident stuck: I think about scope, deadlines and the people waiting on the work,
          and I'm good at turning a fuzzy idea into a plan a team can actually ship.
        </p>
        <p>
          <strong>A designer's eye.</strong> I originally wanted to study graphic design, and I never stopped caring
          about it. I bring that to UI and UX work: clear layouts, motion that helps, accessibility, and the small
          details people feel without naming.
        </p>
        <p>
          <strong>A teacher's patience.</strong> I teach every chance I get. I have mentored developers one to one,
          taught bootcamp classes at Desafio Latam, run workshops for Thinkful students, and given enterprise training.
          I start from what the person already knows, then we work through real problems together.
        </p>
      </div>
    </section>

    <section class="about-section grid gap-sm py-lg lg:grid-cols-12 lg:gap-md" aria-labelledby="about-life">
      <h2 id="about-life" class="label lg:col-span-5">Outside work</h2>
      <div class="prose lg:col-span-7">
        <p>
          People tell me I'm cheerful and positive, and I try to lead with empathy. When I'm not working you will
          usually find me:
        </p>
        <ul>
          <li>taking my wife and daughter on trips so we can see the world together</li>
          <li>tinkering with electronics and taking apart whatever new gadget just came out</li>
          <li>keeping up with what's new in tech and AI, and trying it myself</li>
          <li>teaching someone something</li>
        </ul>
        <p>The soundtrack is usually classic rock or disco.</p>
      </div>
    </section>

    <section class="about-section grid gap-sm py-lg lg:grid-cols-12 lg:gap-md" aria-labelledby="about-languages">
      <h2 id="about-languages" class="label lg:col-span-5">Languages</h2>
      <div class="prose lg:col-span-7">
        <p>English and Spanish.</p>
      </div>
    </section>

    <section class="about-section grid gap-sm py-lg lg:grid-cols-12 lg:gap-md" aria-labelledby="about-contact">
      <h2 id="about-contact" class="label lg:col-span-5">Contact</h2>
      <div class="lg:col-span-7">
        <p class="prose mb-md">The best way to reach me is by email.</p>
        <ul role="list" class="flex flex-wrap gap-sm">
          <li><a class="hit hit-primary" href={`mailto:${SITE.email}`}><Icon name="email" />{SITE.email}</a></li>
          <li><a class="hit" href={SITE.links.linkedin} rel="me"><Icon name="linkedin" />LinkedIn</a></li>
          <li><a class="hit" href={SITE.links.github} rel="me"><Icon name="github" />GitHub</a></li>
          <li>
            <a class="hit" href={SITE.resume} download="Sergei Garcia - Resume.pdf"
              ><Icon name="download" />Resume (PDF)</a
            >
          </li>
        </ul>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Thin rules between about sections, in the page rule color. */
  .about-section {
    border-bottom: var(--rule-thin) solid var(--rule-color);
  }
  .about-section:last-child {
    border-bottom: 0;
  }
  /* The family photo: thick frame like the screenshots, no shadow (it is not a control). */
  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: var(--rule-thick) solid var(--edge);
  }
  @media (min-width: 64rem) {
    .photo {
      max-width: 28rem;
    }
  }
</style>
