---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
---

<Base title="Page not found" description="This page does not exist. Head back to the home page, my work or my projects.">
  <PageHead title="Page not found" band="tomato">
    <p class="mt-md max-w-prose text-lg">That address does not lead anywhere. Try one of these instead.</p>
    <ul role="list" class="mt-md flex flex-wrap gap-sm">
      <li><a class="hit hit-primary" href="/">Home</a></li>
      <li><a class="hit" href="/work/">Work</a></li>
      <li><a class="hit" href="/projects/">Projects</a></li>
    </ul>
  </PageHead>
</Base>
