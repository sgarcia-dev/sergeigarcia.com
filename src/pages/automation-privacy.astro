---
/**
 * Privacy page for "Sergei Automation", Sergei's private Google sign-in setup.
 * Google asks for a privacy policy URL before that app can be published.
 * Public but not linked from anywhere, noindex, and left out of the sitemap (astro.config.mjs).
 */
import Base from "../layouts/Base.astro";
import { SITE } from "../lib/site";
---

<Base
  title="Privacy"
  description="How Sergei Automation, a private tool run by Sergei Garcia, uses Google data."
  noindex
>
  <section class="edge-b">
    <div class="shell py-lg">
      <h1 class="font-display text-h2 tracking-tight">Privacy</h1>
      <p class="mt-sm max-w-prose text-lg">Last updated: 2 November 2026</p>
    </div>
  </section>

  <section>
    <div class="shell py-lg">
      <div class="prose">
        <h2>Who this is for</h2>
        <p>
          Sergei Automation is a private tool. Sergei Garcia runs it, for his own Google accounts. It is not offered to
          anyone else.
        </p>

        <h2>What it can do with Google data</h2>
        <ul>
          <li>Read his mail and calendar.</li>
          <li>Manage mail in the assistant's own mailbox.</li>
          <li>Add events to its own calendar.</li>
          <li>Save its own files to Drive.</li>
        </ul>

        <h2>Where data goes</h2>
        <p>Sign-in keys and working data stay on his own server.</p>
        <p>Mail text is sent to Anthropic's Claude to be summarised and sorted.</p>
        <p>The data is not sold, not used for ads, and not shared with anyone else.</p>
        <p>
          Use of Google data follows the{" "}
          <a href="https://developers.google.com/terms/api-services-user-data-policy">Google API Services User Data Policy</a>,
          including the Limited Use requirements.
        </p>

        <h2>How to delete it</h2>
        <p>
          He can remove access at any time in his Google account. He can also delete the data from his server.
        </p>

        <h2>Contact</h2>
        <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
    </div>
  </section>
</Base>
