---
import WhisperForAndroid from "../../layouts/WhisperForAndroid.astro";
import { WHISPER } from "../../lib/whisperApp";
import Hero from "../../components/WhisperHero/Hero.astro";

const { name, contactEmail, base } = WHISPER;

// Screenshot files live in public/whisper-for-android/shots/. Set width and height to the real
// pixel size of each file so the browser reserves the right space. The phone frame follows the ratio.
const SHOT = { w: 1080, h: 2138 };

const sections = [
  {
    id: "bubble",
    accent: "green",
    title: "Works with any keyboard, in any app.",
    body: "The bubble floats over Google Messages, or whatever you are in. Tap it, talk, and your words land in the text box.",
    alt: "Google Messages with the floating bubble recording while the user dictates.",
  },
  {
    id: "home",
    accent: "blue",
    title: "One home for it all.",
    body: "Dictation, files, voice memos, models and keys, all a tap away from the home screen.",
    alt: "The app home screen listing what the app supports.",
  },
  {
    id: "models",
    accent: "violet",
    title: "Local or cloud. Your pick.",
    body: "Browse many speech models. Run them on your phone, or send audio to a cloud provider.",
    alt: "The model library with local and cloud speech models.",
  },
  {
    id: "model-detail",
    accent: "green",
    title: "Know a model before you use it.",
    body: "Preview any model to see its speed, accuracy, pros and cons.",
    alt: "A model preview sheet with pros and cons.",
  },
  {
    id: "keys",
    accent: "blue",
    title: "Bring your own keys.",
    body: "Add keys for several providers. Your audio goes straight from your phone to the one you choose.",
    alt: "The keys page with several cloud providers.",
  },
  {
    id: "transcript",
    accent: "violet",
    title: "Files and voice memos, handled.",
    body: "Transcribe audio files and memos, tell speakers apart, and clean the text up in the style you like.",
    alt: "A transcript with speaker labels and clean-up style choices.",
  },
  {
    id: "quick-settings",
    accent: "green",
    title: "Make the bubble yours.",
    body: "Quick settings let you tune the bubble and the app without digging through menus.",
    alt: "Quick settings for the bubble and the app.",
  },
  {
    id: "usage",
    accent: "red",
    title: "See what you spend.",
    body: "The usage sheet shows your spend, so cloud costs never surprise you.",
    alt: "The usage sheet showing spend.",
  },
] as const;

const extras = [
  { tone: "green", title: "On-device models", text: "Dictate on your phone, even offline." },
  { tone: "blue", title: "Live captions", text: "Streaming captions as you speak, with Nemotron." },
  { tone: "violet", title: "Voice edit", text: "Hold the bubble and say how to change your text." },
  { tone: "green", title: "12 clean-up styles", text: "Including Translate." },
  { tone: "blue", title: "Custom dictionary", text: "Teach it your names and terms." },
  { tone: "red", title: "Hide per app", text: "Keep the bubble out of apps where you do not want it." },
  { tone: "violet", title: "Shake to send feedback", text: "Shake your phone to tell us what to fix." },
] as const;
---

<WhisperForAndroid
  title={name}
  fullTitle
  description={`${name}: dictate into any app with a floating bubble. Local or cloud speech models. Private beta, invite only.`}
>
  <section class="hero" aria-labelledby="title">
    <div class="hero-text">
      <img class="hero-icon" src={`${base}icon-192.webp`} width="88" height="88" alt="" />
      <h1 id="title">{name}</h1>
      <p class="lead">Dictate into any app with a floating bubble. Local or cloud speech models.</p>
      <p class="beta"><span class="pill">Private beta, invite only</span></p>
      <p class="contact">Want in? <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
    </div>

    <div class="hero-demo">
      <Hero />
    </div>
  </section>

  {
    sections.map((s, i) => (
      <section class={`feature ${s.accent}${i % 2 ? " flip" : ""}`} aria-labelledby={`h-${s.id}`}>
        <div class="copy" data-reveal>
          <span class="bar" aria-hidden="true"></span>
          <h2 id={`h-${s.id}`}>{s.title}</h2>
          <p>{s.body}</p>
        </div>
        <div class="shot" data-reveal>
          <div class="phone" data-tilt>
            <img
              src={`${base}shots/${s.id}.webp`}
              alt={s.alt}
              width={SHOT.w}
              height={SHOT.h}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </section>
    ))
  }

  <section class="extras" aria-labelledby="h-extras">
    <h2 id="h-extras" data-reveal>Everything else</h2>
    <ul>
      {
        extras.map((e) => (
          <li class={e.tone} data-reveal>
            <strong>{e.title}</strong>
            <span>{e.text}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="beta" class="beta-note" aria-labelledby="h-beta" data-reveal>
    <h2 id="h-beta">Private beta, invite only.</h2>
    <p>Whisper for Android is in beta, so rough edges are expected.</p>
    <p class="contact">Want in? <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
    <p class="legal-links"><a href={`${base}privacy/`}>Privacy</a> <a href={`${base}terms/`}>Terms</a></p>
  </section>
</WhisperForAndroid>

<style>
  /* Accent per section */
  .green { --accent: var(--green); --accent-rgb: 148 212 177; }
  .blue { --accent: var(--blue); --accent-rgb: 138 180 248; }
  .violet { --accent: var(--violet); --accent-rgb: 208 188 255; }
  .red { --accent: var(--red-ink); --accent-rgb: 179 38 30; }

  /* Hero */
  .hero {
    display: grid;
    gap: 2.5rem;
    padding: 2.5rem 0 1rem;
    align-items: center;
  }
  .hero-icon {
    display: block;
    width: 60px;
    height: 60px;
    border-radius: 15px;
    margin-bottom: 1.1rem;
    box-shadow: 0 0 0 1px var(--line), 0 14px 40px -6px rgb(42 154 105 / 0.55);
  }
  h1 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.7rem, 13vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    margin: 0 0 1rem;
    text-wrap: balance;
  }
  .lead {
    font-size: clamp(1.15rem, 4.6vw, 1.5rem);
    line-height: 1.4;
    max-width: 30rem;
    margin: 0 0 1.25rem;
    color: var(--ink);
  }
  .beta {
    margin: 0 0 0.75rem;
  }
  .pill {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgb(148 212 177 / 0.4);
    background: rgb(148 212 177 / 0.12);
    color: var(--green);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .contact {
    margin: 0;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  /* Animated phone demo. The hero component sizes itself to this box. */
  .hero-demo {
    position: relative;
    display: grid;
    justify-items: center;
    min-width: 0;
    padding: 0.5rem 0;
  }
  .hero-demo::before {
    content: "";
    position: absolute;
    width: min(30rem, 100%);
    aspect-ratio: 1;
    top: 46%;
    left: 50%;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(148 212 177 / 0.26), transparent 68%);
    filter: blur(10px);
    pointer-events: none;
  }
  .hero-demo > :global(.wh) {
    position: relative;
  }

  /* Feature sections */
  .feature {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: 4.5rem 0 1rem;
  }
  .copy .bar {
    display: block;
    width: 3rem;
    height: 5px;
    border-radius: 3px;
    background: var(--accent);
    margin-bottom: 1.1rem;
    box-shadow: 0 0 20px 0 rgb(var(--accent-rgb) / 0.6);
  }
  h2 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.1rem, 8.4vw, 3.9rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 1rem;
    text-wrap: balance;
  }
  .copy p {
    font-size: clamp(1.1rem, 4.2vw, 1.3rem);
    line-height: 1.5;
    color: var(--muted);
    max-width: 28rem;
    margin: 0;
  }
  .shot {
    position: relative;
    display: grid;
    justify-items: center;
    padding: 1rem 0;
  }
  .shot::before {
    content: "";
    position: absolute;
    width: min(26rem, 100%);
    aspect-ratio: 1;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(var(--accent-rgb) / 0.3), transparent 68%);
    filter: blur(8px);
    pointer-events: none;
  }
  .phone {
    --rx: 0deg;
    --ry: 0deg;
    --ty: 0px;
    position: relative;
    width: min(74vw, 290px);
    padding: 8px;
    border-radius: 2.7rem;
    background: linear-gradient(150deg, #4a5650 0%, #0d1210 38%, #1b2420 70%, #3c4741 100%);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.1),
      inset 0 0 0 1px rgb(255 255 255 / 0.06),
      var(--shadow),
      0 0 90px -20px rgb(var(--accent-rgb) / 0.5);
    transform: perspective(1100px) translateY(var(--ty)) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.18s ease-out;
    will-change: transform;
  }
  .phone img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2.2rem;
    background: #050807;
  }

  /* Scroll reveals, only when JS runs and motion is allowed */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-reveal] {
      opacity: 0;
      transform: translateY(32px);
      transition: opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    :global(.js) [data-reveal].in {
      opacity: 1;
      transform: none;
    }
    :global(.js) .shot[data-reveal]:not(.in) {
      transform: translateY(48px) scale(0.96);
    }
    :global(.js) .extras li[data-reveal]:nth-child(2n) { transition-delay: 0.08s; }
  }
  @media (prefers-reduced-motion: reduce) {
    .phone { transition: none; transform: none; }
  }

  /* Everything else */
  .extras {
    padding: 6rem 0 1rem;
  }
  .extras h2 {
    margin-bottom: 1.75rem;
  }
  .extras ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: 1fr;
  }
  .extras li {
    --accent-rgb: 148 212 177;
    display: grid;
    align-content: start;
    gap: 0.2rem;
    padding: 1.1rem 1.25rem 1.1rem 1.4rem;
    border-radius: 1.1rem;
    border: 1px solid var(--line);
    background: var(--surface);
    position: relative;
    overflow: hidden;
  }
  .extras li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 4px;
    border-radius: 0 3px 3px 0;
    background: var(--accent);
  }
  .extras strong {
    font-family: var(--display);
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .extras span {
    color: var(--muted);
  }

  /* Beta note */
  .beta-note {
    margin: 5rem 0 1rem;
    padding: 2.5rem 1.5rem;
    border-radius: 2rem;
    border: 1px solid var(--line);
    background:
      radial-gradient(30rem 16rem at 0% 0%, rgb(148 212 177 / 0.16), transparent 70%),
      radial-gradient(26rem 16rem at 100% 100%, rgb(208 188 255 / 0.14), transparent 70%),
      var(--surface);
  }
  .beta-note h2 {
    font-size: clamp(1.9rem, 7vw, 3rem);
  }
  .beta-note p {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 1.1rem;
  }
  .legal-links {
    display: flex;
    gap: 1.25rem;
    margin-top: 1rem;
  }
  .legal-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (min-width: 640px) {
    .extras ul {
      grid-template-columns: repeat(2, 1fr);
    }
    .extras li:last-child {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 900px) {
    .hero-icon {
      width: 72px;
      height: 72px;
      border-radius: 18px;
    }
    .hero {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
      padding: 4rem 0 2rem;
    }
    .hero-demo > :global(.wh) {
      --wh-max: 380px;
    }
    .feature {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      padding: 5rem 0 2rem;
    }
    .feature .copy {
      justify-self: end;
      max-width: 30rem;
    }
    .feature.flip .copy {
      order: 2;
      justify-self: start;
    }
    .feature.flip .shot {
      order: 1;
    }
    .phone {
      width: 340px;
    }
    .extras ul {
      grid-template-columns: repeat(3, 1fr);
    }
    .beta-note {
      padding: 4rem 3.5rem;
    }
  }
</style>
