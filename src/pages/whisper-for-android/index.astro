---
import WhisperForAndroid from "../../layouts/WhisperForAndroid.astro";
import { WHISPER, inviteHref } from "../../lib/whisperApp";
import Hero from "../../components/WhisperHero/Hero.astro";
import FeatureVideo from "../../components/FeatureVideo.astro";
import PhoneFrame from "../../components/PhoneFrame.astro";

const { name, contactEmail, base } = WHISPER;

// Screenshot files live in public/whisper-for-android/shots/. Set width and height to the real
// pixel size of each file so the browser reserves the right space. The phone frame follows the ratio.
const SHOT = { w: 1080, h: 2138 };

const sections = [
  {
    id: "home", accent: "blue", title: "Start talking. Keep the text.",
    eyebrow: "Speak",
    body: "Dictate a reply now, or record a voice memo to transcribe later. Your past dictations stay within reach.",
    bullets: ["Use Speak to dictate inside the app.", "Keep the Bubble available over other apps.", "Find earlier text in Dictations.", "Record ideas in Memos and transcribe them when you’re ready."],
    label: "Speak and saved recordings",
    alt: "App home screen with dictation, voice memos and setup options.",
  },
  {
    id: "models", accent: "violet", title: "Dictate without a connection",
    eyebrow: "Models",
    body: "Download a speech model once, then use it offline for free. On-device transcription keeps the audio on your phone.",
    bullets: ["Moonshine tiny English is about 44 MB.", "Whisper tiny English is about 104 MB.", "Parakeet TDT 0.6B v3 supports multilingual speech.", "Nemotron 3.5 Live shows words while you speak."],
    label: "Browse speech models",
    alt: "Model library showing on-device and cloud speech models.",
  },
  {
    id: "model-detail", accent: "green", title: "Know what fits your phone",
    eyebrow: "Before you download",
    body: "Check a model’s download size, memory needs and supported languages before choosing it. Speed and accuracy ratings are guides, not measurements on your phone.",
    bullets: ["Read each model’s strengths and limits.", "Check its dictionary support.", "Choose your main speech model.", "Keep a downloaded backup for cloud failures."],
    label: "Check a model’s details",
    alt: "Model detail sheet with ratings, download size and model notes.",
  },
  {
    id: "keys", accent: "blue", title: "Use the account you already have",
    eyebrow: "Cloud models",
    body: "Add your own API key for providers such as OpenAI, Groq or Deepgram. Cloud requests go to the provider you choose and may incur charges on that account.",
    bullets: ["One OpenRouter key works for speech and Polish.", "Keys are stored in encrypted preferences on your phone.", "Remove a saved key whenever you want.", "Use Offline only to block cloud processing after downloading your models."],
    label: "Add your provider’s key",
    alt: "API key settings listing supported cloud providers.",
  },
  {
    id: "transcript", accent: "violet", title: "Find what someone actually said",
    eyebrow: "Files and Memos",
    body: "Turn a meeting recording into text you can search. Find speakers on your phone, then give their labels names you recognise.",
    bullets: ["Rename speakers or merge duplicate labels.", "Play the recording alongside the transcript.", "Try another speech model and compare versions.", "Export folder transcripts as text or subtitles."],
    label: "Read a transcript with speakers",
    alt: "Recording transcript with speaker labels and text clean-up choices.",
  },
  {
    id: "usage", accent: "red", title: "See where the requests went",
    eyebrow: "Usage",
    body: "Check which models you used and what cloud requests cost. Costs are reported or estimated; missing prices are marked as unknown.",
    bullets: ["Review on-device and cloud requests together.", "Choose the date range to inspect.", "Set your own model rates for future estimates.", "Export the usage record as CSV."],
    label: "Review usage and cost",
    alt: "Usage view showing model activity and cloud spending.",
  },
] as const;

const extras = [
  { tone: "green", icon: "◉", title: "On-device speech", text: "Download a speech model before you go offline. No cloud key needed." },
  { tone: "blue", icon: "≋", title: "Live words", text: "Nemotron 3.5 Live lets you read along while you speak." },
  { tone: "violet", icon: "✦", title: "Edit by voice", text: "Hold the bubble over a text field and say “make it shorter”. Voice editing needs a configured Polish model." },
  { tone: "green", icon: "↻", title: "12 Polish styles", text: "Use Clean up for punctuation and fillers, or Email for a draft with a greeting. Translate lets you choose the output language." },
  { tone: "blue", icon: "Aa", title: "Your own dictionary", text: "Add names and specialist terms to help correct sound-alike mistakes." },
  { tone: "red", icon: "◌", title: "Bubble gestures", text: "Choose what a hold does and assign actions to the screen corners." },
  { tone: "violet", icon: "↗", title: "Send feedback", text: "Shake your phone to open feedback when something needs attention." },
] as const;
---

<WhisperForAndroid
  title={`${name} | Dictate anywhere`}
  fullTitle
  description="Dictate into any Android app with a floating bubble. Free offline speech models, or cloud models with your own key. Private beta."
>
  <section class="hero" aria-labelledby="title">
    <div class="hero-text">
      <p class="availability"><span></span> Private beta for Android</p>
      <h1 id="title">Type less.<br />Say what you mean.</h1>
      <p class="lead">That reply is easier to say than type. Tap the floating bubble, speak, and put your words into the app you already have open.</p>
      <div class="hero-actions">
        <a class="button" href={inviteHref}>Ask for an invite <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#explore">See how it works <span aria-hidden="true">↓</span></a>
      </div>
      <p class="hero-note">On-device speech models are free and work offline after download. Cloud models need your own API key.</p>
    </div>
    <div class="hero-demo">
      <div class="hero-orbit" aria-hidden="true"></div>
      <Hero />
      <span class="demo-label">Dictation without leaving the conversation.</span>
    </div>
  </section>

  <div class="intro" id="explore">
    <p class="section-label">Built for everyday dictation</p>
    <h2>A place for unfinished thoughts</h2>
    <p>I built this for the messages that take too long to thumb out. It also gives you somewhere to talk through an idea and come back to the words later.</p>
  </div>

  <div class="features">
    {sections.map((s, i) => (
      <section class={`feature ${s.accent} ${i === 0 || i === 5 ? "wide" : ""}`} aria-labelledby={`h-${s.id}`}>
        <div class="copy">
          <span class="feature-kind">{s.eyebrow}</span>
          <h2 id={`h-${s.id}`}>{s.title}</h2>
          <p>{s.body}</p>
          <ul class="feature-list">{s.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
        </div>
        <div class="shot">
          <div class="phone-surface" aria-hidden="true"></div>
          <PhoneFrame>
            <FeatureVideo name={s.id} poster={`${base}shots/${s.id}.webp`} alt={s.alt} label={s.label} width={SHOT.w} height={SHOT.h} />
          </PhoneFrame>
        </div>
      </section>
    ))}
  </div>

  <section class="extras" aria-labelledby="h-extras">
    <div class="extras-heading"><p class="section-label">Make it yours</p><h2 id="h-extras">The details you can change</h2></div>
    <ul>{extras.map((e) => (
      <li class={e.tone}>
        <span class="extra-icon" aria-hidden="true">{e.icon}</span>
        <div><h3>{e.title}</h3><p>{e.text}</p></div>
      </li>
    ))}</ul>
  </section>

  <section id="beta" class="beta-note" aria-labelledby="h-beta">
    <div class="beta-symbol" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
    <div><p class="section-label">Private beta, invite only</p><h2 id="h-beta">Try it on your phone</h2><p>I’m still working through the rough edges. Email me for an invite, and tell me what you’d like to dictate.</p>
    <a class="button" href={inviteHref}>Ask for an invite <span aria-hidden="true">↗</span></a>
    <a class="email" href={inviteHref}>{WHISPER.inviteEmail}</a></div>
  </section>
</WhisperForAndroid>

<style>
  /* Product-specific tonal surfaces echo the app's mint, ocean and sand palettes. */
  .green { --accent: var(--green); --tone: #293e32; }
  .blue { --accent: #9eccec; --tone: #25383e; }
  .violet { --accent: #b6c4ff; --tone: #303643; }
  .red { --accent: #ebbe92; --tone: #42372b; }
  h1, h2, h3 { font-family: var(--display); font-weight: 500; }
  h1, h2 { text-wrap: balance; }
  h1 { font-size: clamp(4rem, 7.6vw, 7rem); line-height: .98; letter-spacing: -.065em; margin: 1.5rem 0; }
  h2 { font-size: clamp(2.25rem, 4vw, 3.7rem); line-height: 1.08; letter-spacing: -.045em; margin: 0; }
  .hero { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 2rem; padding: 3rem 1.5rem 4rem; }
  .hero-text { position: relative; z-index: 1; }
  .availability { display: flex; align-items: center; gap: .65rem; color: var(--green); font-size: .85rem; margin: 0; }
  .availability span { width: .5rem; height: .5rem; background: var(--green); border-radius: 50%; }
  .lead { max-width: 25rem; font-size: clamp(1.15rem, 2vw, 1.35rem); line-height: 1.55; color: var(--muted); margin: 1.5rem 0 2rem; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.5rem; }
  .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 2rem; min-height: 56px; padding: .9rem 1.5rem; border-radius: 2rem; background: var(--green); color: var(--on); text-decoration: none; font-weight: 650; }
  .button span { font-size: 1.3rem; line-height: 1; }
  .text-link { display: inline-flex; gap: .8rem; align-items: center; min-height: 48px; color: var(--ink); text-decoration: none; }
  .text-link:hover { text-decoration: underline; }
  .hero-note { margin: 1.2rem 0 0; color: var(--muted); font-size: .8rem; }
  .hero-demo { position: relative; display: grid; place-items: center; padding: 1.5rem 0; min-width: 0; }
  .hero-orbit { position: absolute; inset: 8% 2.5rem 9%; background: #23382b; border-radius: 48% 48% 44% 44%; transform: rotate(-8deg); }
  .hero-demo > :global(.wh) { position: relative; --wh-max: 340px; --wh-accent: var(--green); }
  .demo-label { position: relative; color: var(--muted); font-size: .75rem; margin-top: .75rem; }
  .intro { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem 5rem; padding: 5rem 1.5rem 3rem; border-top: 1px solid var(--line); scroll-margin-top: 2rem; }
  .section-label { font-size: .85rem; color: var(--green); margin: 0 0 1rem; }
  .intro .section-label { grid-column: 1 / -1; margin: 0; }
  .intro > p:last-child { align-self: end; max-width: 26rem; font-size: 1.15rem; color: var(--muted); margin: 0; }
  .features { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .feature { border-radius: 2.5rem; background: var(--surface); padding: 2.5rem 2.5rem 2rem; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }
  .feature-kind { display: block; font-size: .8rem; color: var(--accent); margin-bottom: 1.5rem; }
  .feature h2 { font-size: clamp(2rem, 3.1vw, 3rem); max-width: 17ch; }
  .copy > p { color: var(--muted); font-size: 1.05rem; max-width: 29rem; margin: 1.25rem 0; }
  .feature-list { list-style: none; padding: 0; margin: 1.5rem 0 2rem; display: grid; gap: .65rem; max-width: 29rem; font-size: .9rem; color: var(--muted); }
  .feature-list li { padding-left: 1.4rem; position: relative; }
  .feature-list li::before { content: "✓"; position: absolute; left: 0; color: var(--accent); }
  .shot { position: relative; display: grid; place-items: center; padding: 2rem 0 .75rem; margin-top: auto; isolation: isolate; }
  .phone-surface { position: absolute; inset: 12% 0 0; border-radius: 12rem 12rem 2rem 2rem; background: var(--tone); z-index: -1; }
  .wide { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 3rem; padding: 3rem 4rem; }
  .wide .shot { margin: 0; }
  .wide .phone-surface { inset: 8% -1rem; border-radius: 50% 50% 2rem 2rem; }
  .wide:last-child .copy { order: 2; }
  .wide:last-child .shot { order: 1; }
  .wide:last-child .phone-surface { border-radius: 2rem 2rem 50% 50%; }
  .extras { display: grid; grid-template-columns: .9fr 1.1fr; gap: 4rem; padding: 7rem 1.5rem; }
  .extras ul { list-style: none; padding: 0; margin: 0; }
  .extras li { display: flex; gap: 1.25rem; padding: 1.35rem 0; border-bottom: 1px solid var(--line); }
  .extras li:first-child { padding-top: 0; }
  .extra-icon { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 1rem; background: var(--tone); color: var(--accent); flex: none; font-size: 1.2rem; }
  .extras h3 { margin: 0; font-size: 1.15rem; }
  .extras li p { margin: .25rem 0 0; color: var(--muted); font-size: .95rem; }
  .beta-note { background: #aff1cc; color: #012112; border-radius: 3rem; padding: 4.5rem; display: grid; grid-template-columns: .65fr 1.35fr; align-items: center; gap: 4rem; scroll-margin-top: 2rem; }
  .beta-note .section-label { color: #2c6a4b; }
  .beta-note h2 { font-size: clamp(2.4rem, 4vw, 3.8rem); }
  .beta-note p:not(.section-label) { margin: 1.25rem 0 1.75rem; max-width: 28rem; }
  .beta-note .button { background: #013822; color: #aff1cc; }
  .email { display: block; color: #013822; width: fit-content; margin-top: 1rem; font-size: .85rem; overflow-wrap: anywhere; }
  .beta-symbol { width: 100%; aspect-ratio: 1; border-radius: 50%; background: #94d4b1; display: flex; justify-content: center; align-items: center; gap: 7%; }
  .beta-symbol span { width: 7%; height: 24%; border-radius: 2rem; background: #0f5134; }
  .beta-symbol span:nth-child(2), .beta-symbol span:nth-child(4) { height: 42%; }
  .beta-symbol span:nth-child(3) { height: 58%; }
  @media (prefers-reduced-motion: no-preference) {
    .button { transition: border-radius 350ms var(--ease), transform 350ms var(--ease), box-shadow 350ms var(--ease); }
    .button:hover { border-radius: 1rem; transform: translateY(-2px); box-shadow: 0 6px 0 rgb(148 212 177 / .12); }
    .button:active { transform: scale(.97); }
    .hero-orbit { animation: settle 1.2s cubic-bezier(.2, 0, 0, 1) both; }
    @keyframes settle { from { transform: rotate(0deg) scale(.92); border-radius: 35%; } to { transform: rotate(-8deg) scale(1); border-radius: 48% 48% 44% 44%; } }
    .beta-note:hover .beta-symbol span { animation: voice 1s var(--ease) 2 alternate; }
    .beta-note:hover .beta-symbol span:nth-child(2n) { animation-delay: .12s; }
    @keyframes voice { 50% { transform: scaleY(.6); } }
  }
  @media (max-width: 900px) {
    .hero { padding-inline: .5rem; gap: 1rem; }
    h1 { font-size: clamp(3.3rem, 8vw, 5rem); }
    .hero-actions { gap: .5rem 1rem; }
    .feature { padding: 2rem 1.5rem; }
    .wide { gap: 2rem; }
    .extras { gap: 2rem; }
    .beta-note { padding: 3rem; gap: 2rem; }
  }
  @media (max-width: 650px) {
    .hero { grid-template-columns: 1fr; padding: 2.5rem .25rem 3rem; gap: 2.5rem; }
    h1 { font-size: clamp(3.8rem, 15vw, 5.5rem); margin: 1.25rem 0; }
    .lead { font-size: 1.1rem; margin: 1.25rem 0 1.5rem; max-width: 21rem; }
    .hero-demo { padding: 1rem .75rem; }
    .hero-demo > :global(.wh) { --wh-max: 300px; }
    .hero-orbit { inset: 9% 2.5rem 10%; }
    .intro { grid-template-columns: 1fr; padding: 3rem .25rem 2rem; gap: 1rem; }
    .intro > p:last-child { font-size: 1rem; }
    .features { grid-template-columns: 1fr; gap: .75rem; }
    .feature, .wide { display: flex; flex-direction: column; gap: 0; padding: 2rem 1.25rem 1.25rem; border-radius: 2rem; align-items: stretch; }
    .feature h2 { font-size: 2.15rem; }
    .feature-kind { margin-bottom: 1rem; }
    .feature-list { margin-bottom: 1rem; }
    .wide:last-child .copy, .wide:last-child .shot { order: initial; }
    .shot { padding-top: 1.5rem; }
    .wide .phone-surface, .phone-surface { inset: 12% 0 0; border-radius: 10rem 10rem 1.5rem 1.5rem; }
    .shot :global(.phone-frame) { width: min(100% - 1.5rem, 280px); }
    .extras { grid-template-columns: 1fr; padding: 4rem .25rem; gap: 2.5rem; }
    .extras-heading h2 br { display: none; }
    .beta-note { grid-template-columns: 1fr; gap: 2rem; padding: 2rem 1.5rem; border-radius: 2rem; }
    .beta-symbol { width: 5rem; }
    .beta-note h2 { font-size: 2.4rem; }
    .beta-note .button { min-height: 52px; }
  }
</style>
