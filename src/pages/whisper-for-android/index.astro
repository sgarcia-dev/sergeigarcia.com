---
import WhisperForAndroid from "../../layouts/WhisperForAndroid.astro";
import { WHISPER } from "../../lib/whisperApp";
import Hero from "../../components/WhisperHero/Hero.astro";
import FeatureVideo from "../../components/FeatureVideo.astro";
import PhoneFrame from "../../components/PhoneFrame.astro";

const { name, contactEmail, base } = WHISPER;

// Screenshot files live in public/whisper-for-android/shots/. Set width and height to the real
// pixel size of each file so the browser reserves the right space. The phone frame follows the ratio.
const SHOT = { w: 1080, h: 2138 };

const sections = [
  {
    id: "bubble", accent: "green", title: "Speak wherever you type.",
    body: "A floating bubble brings dictation to your text field.",
    bullets: ["Tap to record and insert at the cursor.", "Drag the bubble to either edge.", "Keep dictating while earlier recordings process.", "Hold the bubble to edit text by voice."],
    alt: "Google Messages with the floating bubble recording while the user dictates.",
  },
  {
    id: "home", accent: "blue", title: "Your voice, ready for any task.",
    body: "Dictation, files and voice memos all have a home here.",
    bullets: ["Record and transcribe voice memos.", "Find past dictations in History.", "Set up models, keys and your dictionary.", "Choose a clean-up style for your words."],
    alt: "The app home screen listing what the app supports.",
  },
  {
    id: "models", accent: "violet", title: "Choose where your speech runs.",
    body: "Pick an on-device model or a cloud provider.",
    bullets: ["Run Parakeet, Whisper, Moonshine, Canary or Qwen3-ASR on your phone.", "See words as you speak with Nemotron live streaming.", "Choose a local backup for cloud transcription.", "Filter models by language or download status."],
    alt: "The model library with local and cloud speech models.",
  },
  {
    id: "model-detail", accent: "green", title: "Find the model that fits.",
    body: "Compare the details before choosing a speech model.",
    bullets: ["Compare speed, accuracy and language support.", "Check download size and memory needs.", "See dictionary support and model notes.", "Set a model as primary or local backup."],
    alt: "A model preview sheet with pros and cons.",
  },
  {
    id: "keys", accent: "blue", title: "Bring your own cloud keys.",
    body: "Choose your provider and use your own account.",
    bullets: ["Add keys for providers including OpenAI, Groq and Deepgram.", "Use OpenRouter for speech and clean-up.", "Store keys in encrypted preferences.", "Remove a key whenever you want."],
    alt: "The keys page with several cloud providers.",
  },
  {
    id: "transcript", accent: "violet", title: "Turn recordings into useful text.",
    body: "Transcribe files and memos, then work with the result.",
    bullets: ["Detect, rename and merge speakers.", "Transcribe a file again with another model.", "Search text and play audio alongside it.", "Export transcripts as text or subtitles."],
    alt: "A transcript with speaker labels and clean-up style choices.",
  },
  {
    id: "quick-settings", accent: "green", title: "Change dictation settings without leaving your app.",
    body: "Open quick options from the bubble when you need them.",
    bullets: ["Switch between local and cloud speech.", "Choose a clean-up style or language.", "Hide the bubble for minutes or in this app.", "Copy your last transcript."],
    alt: "Quick settings for the bubble and the app.",
  },
  {
    id: "usage", accent: "red", title: "Keep an eye on usage and cost.",
    body: "See your local and cloud requests in one place.",
    bullets: ["Review reported or estimated spend.", "See usage across date ranges.", "Set price overrides for models.", "Export usage as CSV."],
    alt: "The usage sheet showing spend.",
  },
] as const;

const extras = [
  { tone: "green", icon: "◉", title: "On-device speech", text: "Dictate on your phone, even offline." },
  { tone: "blue", icon: "≋", title: "Live streaming", text: "See words as you speak with Nemotron." },
  { tone: "violet", icon: "✦", title: "Voice edit", text: "Hold the bubble and say what to change." },
  { tone: "green", icon: "↻", title: "12 clean-up styles", text: "Polish your words or translate them." },
  { tone: "blue", icon: "Aa", title: "Custom dictionary", text: "Fix sound-alike mistakes in your terms." },
  { tone: "red", icon: "◌", title: "Bubble controls", text: "Set hold and corner gestures to suit you." },
  { tone: "violet", icon: "↗", title: "Shake to send feedback", text: "Shake your phone to share feedback." },
] as const;
---

<WhisperForAndroid
  title={name}
  fullTitle
  description={`${name}: dictate into any app with a floating bubble. Local or cloud speech models. Private beta, invite only.`}
>
  <section class="hero" aria-labelledby="title">
    <div class="hero-text">
      <img class="hero-icon" src={`${base}icon-192.webp`} width="88" height="88" alt="" />
      <h1 id="title">{name}</h1>
      <p class="lead">Dictate into any app with a floating bubble. Local or cloud speech models.</p>
      <p class="beta"><span class="pill">Private beta, invite only</span></p>
      <p class="contact">Want in? <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
    </div>

    <div class="hero-demo">
      <Hero />
    </div>
  </section>

  {
    sections.map((s, i) => (
      <section class={`feature ${s.accent}${i % 2 ? " flip" : ""}`} aria-labelledby={`h-${s.id}`}>
        <div class="copy">
          <span class="bar" aria-hidden="true"></span>
          <h2 id={`h-${s.id}`}>{s.title}</h2>
          <p>{s.body}</p>
          <ul class="feature-list">{s.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
        </div>
        <div class="shot">
          <PhoneFrame>
            <FeatureVideo
              name={s.id}
              poster={`${base}shots/${s.id}.webp`}
              alt={s.alt}
              width={SHOT.w}
              height={SHOT.h}
            />
          </PhoneFrame>
        </div>
      </section>
    ))
  }

  <section class="extras" aria-labelledby="h-extras">
    <h2 id="h-extras">More ways to make it yours.</h2>
    <ul>
      {
        extras.map((e) => (
          <li class={e.tone}>
            <span class="extra-icon" aria-hidden="true">{e.icon}</span>
            <strong>{e.title}</strong>
            <span>{e.text}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="beta" class="beta-note" aria-labelledby="h-beta" data-reveal>
    <h2 id="h-beta">Private beta, invite only.</h2>
    <p>Whisper for Android is in beta, so rough edges are expected.</p>
    <h3 class="contact-h">Contact</h3>
    <p class="contact">Want in? <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
    <p class="legal-links"><a href={`${base}privacy/`}>Privacy</a> <a href={`${base}terms/`}>Terms</a></p>
  </section>
</WhisperForAndroid>

<style>
  /* Accent per section */
  .green { --accent: var(--green); --accent-rgb: 148 212 177; }
  .blue { --accent: var(--blue); --accent-rgb: 138 180 248; }
  .violet { --accent: var(--violet); --accent-rgb: 208 188 255; }
  .red { --accent: var(--red-ink); --accent-rgb: 179 38 30; }

  /* Hero */
  .hero {
    display: grid;
    gap: 2.5rem;
    padding: 2.5rem 0 1rem;
    align-items: center;
  }
  .hero-icon {
    display: block;
    width: 60px;
    height: 60px;
    border-radius: 15px;
    margin-bottom: 1.1rem;
    box-shadow: 0 0 0 1px var(--line), 0 14px 40px -6px rgb(42 154 105 / 0.55);
  }
  h1 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.7rem, 13vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    margin: 0 0 1rem;
    text-wrap: balance;
  }
  .lead {
    font-size: clamp(1.15rem, 4.6vw, 1.5rem);
    line-height: 1.4;
    max-width: 30rem;
    margin: 0 0 1.25rem;
    color: var(--ink);
  }
  .beta {
    margin: 0 0 0.75rem;
  }
  .pill {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgb(148 212 177 / 0.4);
    background: rgb(148 212 177 / 0.12);
    color: var(--green);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .contact {
    margin: 0;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  /* Animated phone demo. The hero component sizes itself to this box. */
  .hero-demo {
    position: relative;
    display: grid;
    justify-items: center;
    min-width: 0;
    padding: 0.5rem 0;
  }
  .hero-demo::before {
    content: "";
    position: absolute;
    width: min(30rem, 100%);
    aspect-ratio: 1;
    top: 46%;
    left: 50%;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(148 212 177 / 0.26), transparent 68%);
    filter: blur(10px);
    pointer-events: none;
  }
  .hero-demo > :global(.wh) {
    position: relative;
  }

  /* Feature sections */
  .feature {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: 4.5rem 0 1rem;
  }
  .copy .bar {
    display: block;
    width: 3rem;
    height: 5px;
    border-radius: 3px;
    background: var(--accent);
    margin-bottom: 1.1rem;
    box-shadow: 0 0 20px 0 rgb(var(--accent-rgb) / 0.6);
  }
  h2 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.1rem, 8.4vw, 3.9rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 1rem;
    text-wrap: balance;
  }
  .copy p {
    font-size: clamp(1.1rem, 4.2vw, 1.3rem);
    line-height: 1.5;
    color: var(--muted);
    max-width: 28rem;
    margin: 0;
  }
  .shot {
    position: relative;
    display: grid;
    justify-items: center;
    padding: 1rem 0;
  }
  .feature-list { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 0.75rem; }
  .feature-list li { position: relative; padding-left: 1.35rem; color: var(--ink); }
  .feature-list li::before { content: ""; position: absolute; left: 0; top: 0.65em; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--accent); }

  /* Scroll reveals, only when JS runs and motion is allowed */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-reveal] {
      opacity: 0;
      transform: translateY(32px);
      transition: opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    :global(.js) [data-reveal].in {
      opacity: 1;
      transform: none;
    }
    :global(.js) .shot[data-reveal]:not(.in) {
      transform: translateY(48px) scale(0.96);
    }
    :global(.js) .extras li[data-reveal]:nth-child(2n) { transition-delay: 0.08s; }
  }

  /* Everything else */
  .extras {
    padding: 6rem 0 1rem;
  }
  .extras h2 {
    margin-bottom: 1.75rem;
  }
  .extras ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: 1fr;
  }
  .extras li {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--surface);
  }
  .extras .extra-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.55rem;
    border: 1px solid var(--accent);
    border-radius: 0.5rem;
    color: var(--accent);
    font-weight: 700;
    font-size: 1.15rem;
  }
  .extras strong {
    font-family: var(--display);
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .extras span {
    color: var(--muted);
  }

  /* Beta note */
  .beta-note {
    margin: 5rem 0 1rem;
    padding: 2.5rem 1.5rem;
    border-radius: 2rem;
    border: 1px solid var(--line);
    background:
      radial-gradient(30rem 16rem at 0% 0%, rgb(148 212 177 / 0.16), transparent 70%),
      radial-gradient(26rem 16rem at 100% 100%, rgb(208 188 255 / 0.14), transparent 70%),
      var(--surface);
  }
  .beta-note h2 {
    font-size: clamp(1.9rem, 7vw, 3rem);
  }
  .beta-note p {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 1.1rem;
  }
  .contact-h {
    margin: 1.25rem 0 0.4rem;
    font-size: 1.1rem;
  }
  .legal-links {
    display: flex;
    gap: 1.25rem;
    margin-top: 1rem;
  }
  .legal-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (min-width: 640px) {
    .extras ul {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 900px) {
    .hero-icon {
      width: 72px;
      height: 72px;
      border-radius: 18px;
    }
    .hero {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
      padding: 4rem 0 2rem;
    }
    .hero-demo > :global(.wh) {
      --wh-max: 380px;
    }
    .feature {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      padding: 5rem 0 2rem;
    }
    .feature .copy {
      order: 2;
      justify-self: start;
      max-width: 30rem;
    }
    .feature .shot { order: 1; }
    .feature.flip .copy { order: 1; justify-self: end; }
    .feature.flip .shot { order: 2; }
    .extras ul {
      grid-template-columns: repeat(3, 1fr);
    }
    .beta-note {
      padding: 4rem 3.5rem;
    }
  }
</style>
