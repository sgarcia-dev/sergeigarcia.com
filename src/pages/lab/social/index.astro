---
/**
 * Unlisted lab page: five designs for the social link-preview image (og:image, 1200x630), each
 * shown the way it would appear on each platform, for three sample pages. It only compares
 * designs. Nothing here is wired into og:image yet.
 * Public but not linked from anywhere, noindex, and left out of the sitemap (astro.config.mjs).
 * The data is in src/lib/social.ts, the drawings in src/components/social/.
 *
 * Query switches (read by the inline script below):
 *   ?safe                      draws the crop lines: pink = square thumbnail, blue = 2:1 crop.
 *   ?raw&d=<id>&s=<sample>     one image at native 1200x630 with no page around it (for PNG export).
 *                              d is s1 to s5, s is post, home or page. Example: ?raw&d=s2&s=post
 */
import Base from "../../../layouts/Base.astro";
import OgImage from "../../../components/social/OgImage.astro";
import PlatformFrame from "../../../components/social/PlatformFrame.astro";
import { DESIGNS, FRAMES, SAFE } from "../../../lib/social";
import { getSamples } from "../../../lib/socialSamples";

const SAMPLES = await getSamples();
const GROUPS = [
  { kind: "post", title: "Articles", blurb: "Copy comes from each post (see the og fields in src/content.config.ts). Both posts are shown for every design." },
  { kind: "home", title: "Homepage", blurb: "Built to look like the homepage hero: giant name, yellow and cobalt halves, the tagline." },
  { kind: "page", title: "Generic pages", blurb: "One shared design for Projects, Writing and About, from the page title and description." },
] as const;
---

<Base
  title="Social image lab"
  description="Unlisted lab page: designs for the social link-preview image on sergeigarcia.com, shown on each platform."
  noindex
>
  <script is:inline>
    // Runs before the content is parsed, so there is no flash of the full page in raw view.
    (function () {
      var q = new URLSearchParams(location.search);
      var root = document.documentElement;
      if (q.has("safe")) root.setAttribute("data-safe", "");
      if (q.has("raw")) root.setAttribute("data-raw", "");
    })();
  </script>

  <section class="edge-b">
    <div class="shell py-lg">
      <h1 class="font-display text-h2 tracking-tight">Social image lab</h1>
      <p class="mt-md max-w-prose text-lg">
        Round 2. Designs for the image that shows when a page is shared, each 1200x630, shown below as it would look on
        LinkedIn, X, Facebook, Slack, Discord, iMessage, WhatsApp and Mastodon. Articles, the homepage and generic pages
        each get their own designs.
      </p>
      <p class="mt-sm max-w-prose">
        Nothing here is live yet. Add <code>?safe</code> to the address to draw the crop lines: pink is the square
        thumbnail (x {SAFE.x} to {SAFE.x + SAFE.w}), blue is the 2:1 crop (y {SAFE.y} to {SAFE.y + SAFE.h}). Add
        <code>?raw&amp;d=a2&amp;s=ai-raises-the-floor</code> for one image at full size.
      </p>
      <ul role="list" class="mt-md flex flex-wrap gap-sm">
        {DESIGNS.map((d) => <li><a class="hit" href={`#${d.id}`}>{d.name}</a></li>)}
      </ul>
    </div>
  </section>

  {
    GROUPS.map((g) => (
      <Fragment>
      <section class="edge-b group-head" aria-labelledby={`g-${g.kind}`}>
        <div class="shell py-md">
          <h2 id={`g-${g.kind}`} class="font-display text-h2 tracking-tight">{g.title}</h2>
          <p class="mt-xs max-w-prose">{g.blurb}</p>
        </div>
      </section>
      {DESIGNS.filter((d) => d.kind === g.kind).map((d) => (
        <section id={d.id} class="edge-b scroll-mt" aria-labelledby={`${d.id}-h`}>
          <div class="shell py-lg">
            <h3 id={`${d.id}-h`} class="font-title text-xl">{d.name}</h3>
            <p class="mt-xs max-w-prose">{d.note}</p>
            <p class="mt-xs max-w-prose">
              <span class="badge" data-safe-status={d.safe}>{d.safe === "pass" ? "Safe box: pass" : "Safe box: degrades"}</span>{" "}
              {d.safeNote} Draws: {d.uses}.
            </p>
            {SAMPLES.filter((s) => s.kind === d.kind).map((s) => (
              <div class="sample">
                <h4 class="sample-h">{s.label}</h4>
                <div class="sample-row">
                  <figure class="nat-fig">
                    <div class="nat" data-native={`${d.id}-${s.id}`}>
                      <div class="nat-scale">
                        <OgImage design={d.id} sample={s} />
                      </div>
                    </div>
                    <figcaption class="nat-cap">
                      <strong>{d.name} full image</strong>
                      <span>
                        1200x630, shown at 50%. <a href={`?raw&d=${d.id}&s=${s.id}`}>Native size</a>
                      </span>
                    </figcaption>
                  </figure>
                  {FRAMES.map((f) => (
                    <PlatformFrame frame={f} design={d.id} sample={s} />
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
      </Fragment>
    ))
  }
</Base>

<script>
  // Raw view: keep only the one image that ?d= and ?s= name, at its native size, and nothing else.
  const q = new URLSearchParams(location.search);
  if (q.has("raw")) {
    const d = q.get("d") ?? "s1";
    const s = q.get("s") ?? "post";
    const img = document.querySelector<HTMLElement>(`[data-native="${d}-${s}"] .og`);
    if (img) {
      document.body.replaceChildren(img);
      document.documentElement.setAttribute("data-ready", "");
    } else {
      document.documentElement.setAttribute("data-raw-missing", "");
    }
  }
</script>

<style is:global>
  html[data-raw] body {
    margin: 0;
    padding: 0;
    background: #fff;
  }
  /* Hide the full page for the instant before the script swaps it for the one image. */
  html[data-raw]:not([data-ready]):not([data-raw-missing]) body {
    visibility: hidden;
  }
  .scroll-mt {
    scroll-margin-top: calc(var(--hh, 0px) + 1rem);
  }
  .badge {
    display: inline-block;
    padding: 0 var(--spacing-xs);
    border: var(--rule-thin) solid #0a0a0a;
    background: #ffd400;
    color: #0a0a0a;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .badge[data-safe-status="degrades"] {
    background: #ff6a44;
  }
  .sample {
    margin-top: var(--spacing-lg);
  }
  .sample-h {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.25;
  }
  .sample-row {
    margin-top: var(--spacing-sm);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--spacing-md) var(--spacing-lg);
  }
  .nat-fig {
    margin: 0;
    flex: none;
    width: 604px;
    max-width: 100%;
  }
  .nat {
    width: 600px;
    max-width: 100%;
    height: 315px;
    overflow: hidden;
    border: var(--rule-thin) solid var(--edge);
    box-sizing: content-box;
  }
  .nat-scale {
    width: 1200px;
    height: 630px;
    transform: scale(0.5);
    transform-origin: 0 0;
  }
  .nat-cap {
    margin-top: 6px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--text-xs);
    line-height: 1.35;
  }
</style>
