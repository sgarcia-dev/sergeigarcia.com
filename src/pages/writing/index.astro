---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import PostRow from "../../components/PostRow.astro";
import { getPosts, getAllPosts } from "../../lib/content";
import { WRITING_BAND } from "../../lib/site";
import { PAGE_META } from "../../lib/pageMeta";

const posts = await getPosts();
const drafts = posts.length === 0 ? await getAllPosts() : [];
---

<Base title={PAGE_META.writing.title} description={PAGE_META.writing.description}>
  <PageHead title="Writing" band={WRITING_BAND}>
    <p class="mt-md max-w-prose text-lg">
      Notes on building software and working with AI coding agents.
    </p>
  </PageHead>
  <section class="edge-b" aria-label="Posts">
    <div class="shell grid gap-md py-lg lg:grid-cols-12 lg:gap-lg lg:py-xl">
      <div class="lg:col-span-4">
        <p class="label">{posts.length === 0 ? "No posts yet" : `${posts.length} ${posts.length === 1 ? "post" : "posts"}`}</p>
        <p class="mt-xs max-w-prose">
          {posts.length === 0 ? "The first post is on its way." : "Newest first."}
        </p>
      </div>
      <ul role="list" class="list lg:col-span-8">
        {
          posts.length === 0 ? (
            <li class="row">
              <p class="label">Soon</p>
              <div>
                <h2 class="font-title text-xl">First post coming soon</h2>
                {drafts.length > 0 && (
                  <ul role="list" class="mt-sm grid gap-xs">
                    {drafts.map((d) => (
                      <li class="flex flex-wrap items-baseline gap-x-md gap-y-xs">
                        <span>{d.data.title}</span>
                        <span class="label tag">Coming soon</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ) : (
            posts.map((post) => <PostRow post={post} />)
          )
        }
      </ul>
    </div>
  </section>
</Base>
