---
import type { InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Pills from "../../components/Pills.astro";
import Thumb from "../../components/Thumb.astro";
import { getPosts, formatDate, vtName } from "../../lib/content";
import { SITE } from "../../lib/site";
import { AUTHOR_REF, shareImage } from "../../lib/seo";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props;
const { title, summary, pubDate, updatedDate, skills, cover, coverAlt } = entry.data;
const { Content } = await render(entry);

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = cover ? await shareImage(cover) : undefined;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description: summary,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: AUTHOR_REF,
    ...(ogImage ? { image: new URL(ogImage, SITE.url).href } : {}),
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Writing", item: `${SITE.url}/writing/` },
      { "@type": "ListItem", position: 3, name: title, item: canonical },
    ],
  },
];
---

<Base title={title} description={summary} ogType="article" jsonLd={jsonLd} ogImage={ogImage} ogImageAlt={coverAlt}>
  <PageHead title={title} band="tomato" vt={vtName("posts", entry.id)} size={title.length > 40 ? "xl" : "h2"}>
    <p class="label mt-md">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    </p>
  </PageHead>
  <section class="edge-b">
    <div class="shell grid gap-lg py-lg lg:grid-cols-12 lg:py-xl">
      <div class="lg:col-span-4">
        <p class="max-w-prose">{summary}</p>
        {
          skills.length > 0 && (
            <div class="mt-sm">
              <Pills skills={skills} label="Topics" />
            </div>
          )
        }
      </div>
      <div class="post-body lg:col-span-8">
        {
          cover && (
            <div class="mb-lg max-w-prose">
              <Thumb image={cover} alt={coverAlt ?? ""} size="lg" ratio="wide" eager />
            </div>
          )
        }
        <div class="prose">
          <Content />
        </div>
        <p class="mt-lg"><a class="hit" href="/writing/">All writing</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Let wide content (code blocks, tables) scroll inside the column instead of
     stretching the grid past the screen on phones. */
  .post-body {
    min-width: 0;
  }
  /* Markdown images in posts get the same frame as page images. */
  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin-block: var(--spacing-md);
    border: var(--rule-thick) solid var(--edge);
    box-shadow: 6px 6px 0 var(--edge);
    background: var(--color-white);
  }
  /* Simple ruled tables. */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-base);
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: var(--spacing-2xs) var(--spacing-xs) var(--spacing-2xs) 0;
    border-bottom: var(--rule-thin) solid var(--rule-color);
  }
  .prose :global(th) {
    font-weight: 700;
    border-bottom-width: var(--rule-thick);
  }
  /* On phones, a slightly smaller code font lets the folder tree fit without scrolling. */
  @media (max-width: 40rem) {
    .prose :global(pre) {
      font-size: 0.6875rem;
      padding: var(--spacing-xs);
    }
  }
</style>
