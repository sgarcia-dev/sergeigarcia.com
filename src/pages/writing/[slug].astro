---
import type { InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Pills from "../../components/Pills.astro";
import Thumb from "../../components/Thumb.astro";
import ShareLinks from "../../components/ShareLinks.astro";
import AuthorCard from "../../components/AuthorCard.astro";
import TldrBox from "../../components/TldrBox.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { getPosts, formatDate, vtName } from "../../lib/content";
import { SITE, WRITING_BAND } from "../../lib/site";
import { readingMinutes } from "../../lib/readingTime";
import { AUTHOR_REF, shareImage } from "../../lib/seo";
import { markHtml, plain } from "../../lib/mark";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props;
const { title, summary, pubDate, updatedDate, skills, cover, coverAlt } = entry.data;
const { Content, headings } = await render(entry);
const minutes = readingMinutes(entry.body);
// The "Introduction" heading is added by this page (not in the post file), so add it to the contents too.
const tocHeadings = cover ? [{ depth: 2, slug: "introduction", text: "Introduction" }, ...headings] : headings;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = cover ? await shareImage(cover) : undefined;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description: plain(summary),
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: AUTHOR_REF,
    ...(ogImage ? { image: new URL(ogImage, SITE.url).href } : {}),
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Writing", item: `${SITE.url}/writing/` },
      { "@type": "ListItem", position: 3, name: title, item: canonical },
    ],
  },
];
---

<Base title={title} description={plain(summary)} ogType="article" jsonLd={jsonLd} ogImage={ogImage} ogImageAlt={coverAlt} readMinutes={minutes} preloadBody>
  <PageHead title={title} band={WRITING_BAND} vt={vtName("posts", entry.id)} size="post" progress>
    <p class="label mt-md">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    </p>
    <p class="label mt-xs">{minutes} min read</p>
    {
      cover && (
        <Fragment slot="cover">
          <Thumb image={cover} alt={coverAlt ?? ""} size="lg" ratio="wide" eager sizes="(min-width: 30rem) 30rem, 100vw" />
        </Fragment>
      )
    }
  </PageHead>
  <section class="edge-b">
    <div class="shell grid gap-lg py-lg lg:grid-cols-12 lg:py-xl">
      <div class="lg:col-span-4">
        <TldrBox html={markHtml(summary)} />
        {
          skills.length > 0 && (
            <div class="mt-md">
              <Pills skills={skills} label="Topics" />
            </div>
          )
        }
        <div class="side-sticky">
          <TableOfContents headings={tocHeadings} />
          <div class="side-share">
            <ShareLinks url={canonical} title={title} class="mt-md" headingId="share-h-side" />
          </div>
        </div>
      </div>
      <div class="post-body lg:col-span-8">
        <div class="prose" data-rt-body>
          {/* The cover now sits in the page head, so the body opens with its own heading. */}
          {cover && <h2 id="introduction">Introduction</h2>}
          <Content />
        </div>
        <AuthorCard />
        <div class="end-share">
          <ShareLinks url={canonical} title={title} />
        </div>
        <p class="mt-lg"><a class="hit" href="/writing/">All writing</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Desktop: the contents list and the share links ride along in the left column, under the summary
     and topic pills. --stick-top (motion.css) is the height of the sticky header plus the page head
     banner, so the block never sits under them. The column is as tall as the post, so the block stops
     at the bottom of the post and never reaches the footer. If the screen is short, the block scrolls
     on its own instead of running off the bottom. */
  .side-sticky {
    margin-top: var(--spacing-md);
  }
  .side-share {
    display: none;
  }
  @media (min-width: 64rem) {
    .side-sticky {
      position: sticky;
      top: var(--stick-top, var(--spacing-md));
      max-height: calc(100dvh - var(--stick-top, var(--spacing-md)) - var(--spacing-md));
      overflow-y: auto;
      overscroll-behavior: contain;
      /* Room so the focus outline of the first and last items is not clipped by the scroll box. */
      padding: 4px;
      margin: var(--spacing-md) -4px 0;
    }
    .side-share {
      display: block;
    }
    /* A quieter heading here, so it sits comfortably under the small Contents label. */
    .side-share :global(h2) {
      font-size: var(--text-lg);
    }
    /* Share links live in the sticky column on desktop, and at the end of the post below that. */
    .end-share {
      display: none;
    }
  }
  /* Let wide content (code blocks, tables) scroll inside the column instead of
     stretching the grid past the screen on phones. */
  .post-body {
    min-width: 0;
  }
  /* Markdown images in posts get the same frame as page images. Images inside components
     (<Figure>, the video thumbnail) are not in a paragraph and style themselves. */
  .prose :global(p > img) {
    display: block;
    width: 100%;
    height: auto;
    margin-block: var(--spacing-md);
    border: var(--rule-thick) solid var(--edge);
    box-shadow: 6px 6px 0 var(--edge);
    background: var(--color-white);
  }
  /* Simple ruled tables. */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-base);
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: var(--spacing-2xs) var(--spacing-xs) var(--spacing-2xs) 0;
    border-bottom: var(--rule-thin) solid var(--rule-color);
  }
  .prose :global(th) {
    font-weight: 700;
    border-bottom-width: var(--rule-thick);
  }
  /* On phones, a slightly smaller code font lets the folder tree fit without scrolling. */
  @media (max-width: 40rem) {
    .prose :global(pre) {
      font-size: 0.6875rem;
      padding: var(--spacing-xs);
    }
  }
</style>
