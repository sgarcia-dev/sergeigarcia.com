---
import Base from "../layouts/Base.astro";
---

<Base
  title="Sergei Garcia"
  description="Sergei Garcia is a senior software engineer. Site coming soon."
>
  <main class="mx-auto max-w-column px-6 py-24 md:py-40">
    <h1 class="font-serif text-display">Sergei Garcia</h1>
    <p class="mt-6 text-muted">Senior software engineer. Site coming soon.</p>
    <ul class="mt-10 flex gap-6">
      <li>
        <a
          class="underline underline-offset-4 hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
          href="https://www.linkedin.com/in/sergeigarcia">LinkedIn</a
        >
      </li>
      <li>
        <a
          class="underline underline-offset-4 hover:text-accent focus-visible:outline-2 focus-visible:outline-accent"
          href="https://github.com/sgarcia-dev">GitHub</a
        >
      </li>
    </ul>
  </main>
</Base>
