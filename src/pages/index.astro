---
import Base from "../layouts/Base.astro";
import WorkRow from "../components/WorkRow.astro";
import ProjectRow from "../components/ProjectRow.astro";
import PostRow from "../components/PostRow.astro";
import Icon from "../components/Icon.astro";
import Testimonials from "../components/Testimonials.astro";
import { RECOMMENDATIONS_URL } from "../lib/testimonials";
import { Picture } from "astro:assets";
import { SITE, WRITING_BAND, ABOUT_BAND } from "../lib/site";
import headshot from "../assets/about/headshot.jpg";
import { PERSON, PERSON_ID } from "../lib/seo";
import { getWork, getProjects, getPosts, getAllPosts } from "../lib/content";

const work = await getWork();
const projects = await getProjects();
const posts = await getPosts();
const upcoming = posts.length === 0 ? (await getAllPosts()).slice(0, 1) : [];

const featuredWork = work.slice(0, 4);
const featuredProjects = projects.slice(0, 4);

// Ticker under the hero: short phrases that describe Sergei. If you change the list, re-measure
// the copy width and update --ticker-w in lively.css (the loop time follows from it). The list is
// short, so each copy shows it twice (the second run is aria-hidden) to stay wider than the widest
// screen (3000px). Screen readers get each phrase once.
const tickerItems = [
  "Developer tools",
  "Accessibility",
  "Web performance",
  "AI agent workflows",
  "Writer",
  "UX and motion",
  "Mentor",
  "Speaker",
  "Full stack",
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: `${SITE.url}/`,
    description: SITE.description,
    inLanguage: "en",
    author: { "@id": PERSON_ID },
    publisher: { "@id": PERSON_ID },
  },
  PERSON,
];
---

<Base title={SITE.title} fullTitle description={SITE.description} jsonLd={jsonLd} home>
  <section class="hero edge-b" aria-label="Introduction">
    <!-- Empty halves that carry the band texture out to the screen edges (see texture.css). -->
    <span class="hero-bleed band-yellow" aria-hidden="true"></span>
    <span class="hero-bleed band-cobalt" aria-hidden="true"></span>
    <div class="hero-inner grid lg:grid-cols-12">
      <div class="band-yellow flex flex-col justify-end px-sm py-lg lg:col-span-7 lg:px-lg lg:py-xl">
        <Picture
          src={headshot}
          formats={["avif", "webp"]}
          widths={[64, 128, 192]}
          sizes="4.5rem"
          alt="Photo of Sergei Garcia"
          loading="eager"
          decoding="async"
          class="avatar"
          pictureAttributes={{ class: "block mb-sm lg:mb-md" }}
        />
        <h1 class="name font-display text-display tracking-tight lg:text-display-lg">
          <span class="block">Sergei</span>
          <span class="block">Garcia</span>
        </h1>
      </div>
      <div class="band-cobalt hero-aside px-sm py-lg lg:col-span-5 lg:px-lg lg:py-xl">
        <p class="font-title text-xl">Designer by eye, teacher by habit, engineer by trade.</p>
        <p class="mt-sm text-base font-medium">Software Engineer · 13+ years</p>
        <p class="label mt-xs">Based in {SITE.location}</p>
        <p class="mt-md max-w-prose text-lg">
          I build fast, accessible websites and the tools that help teams ship them. I care how things look and feel, I love
          helping people get unstuck, and lately I'm exploring how far AI can take all of that.
        </p>
        <ul role="list" class="mt-md flex flex-col gap-sm">
          <li><a class="hit hit-primary w-full" href={`mailto:${SITE.email}`}><Icon name="email" />{SITE.email}</a></li>
          <li><a class="hit w-full" href={SITE.links.linkedin} rel="me noopener"><Icon name="linkedin" />LinkedIn</a></li>
          <li><a class="hit w-full" href={SITE.links.github} rel="me noopener"><Icon name="github" />GitHub</a></li>
          <li>
            <a class="hit w-full" href={SITE.resume} download="Sergei Garcia - Resume.pdf"
              ><Icon name="download" />Download resume (PDF)</a
            >
          </li>
        </ul>
      </div>
    </div>
  </section>

  <div class="ticker edge-b">
    <div class="ticker-track">
      <ul role="list" class="ticker-list" aria-label="What I do">
        {tickerItems.map((item) => <li>{item}</li>)}
        {tickerItems.map((item) => <li class="ticker-repeat" aria-hidden="true">{item}</li>)}
      </ul>
      <ul role="list" class="ticker-list ticker-copy" aria-hidden="true">
        {tickerItems.map((item) => <li>{item}</li>)}
        {tickerItems.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>

  <section id="work" class="edge-b" aria-labelledby="work-h">
    <div class="shell grid gap-md py-lg lg:grid-cols-12 lg:gap-lg lg:py-xl">
      <div class="section-head lg:col-span-4 xl:col-span-5">
        <h2 id="work-h" class="font-display text-h2 tracking-tight">Work</h2>
        <p class="mt-sm max-w-prose text-muted">Over <span class="lv-mark">13 years</span> of front-end and full-stack roles, from consulting to product teams.</p>
      </div>
      <div class="lg:col-span-8 xl:col-span-7">
        <ul role="list" class="list">
          {featuredWork.map((entry) => <WorkRow entry={entry} level="h3" compact />)}
        </ul>
        <p class="mt-md"><a class="hit" href="/work/">All work history</a></p>
      </div>
    </div>
  </section>

  <section id="kind-words" class="band-yellow edge-b" aria-labelledby="kind-words-h">
    <div class="shell py-lg lg:py-xl">
      <div class="flex flex-wrap items-end justify-between gap-md">
        <div>
          <h2 id="kind-words-h" class="font-display text-h2 tracking-tight">Kind words</h2>
          <p class="mt-sm max-w-prose">From managers, teammates and people I mentored.</p>
        </div>
        <p class="flex flex-wrap gap-sm">
          <a class="hit" href="/about/#kind-words">More kind words</a>
          <a class="hit" href={RECOMMENDATIONS_URL} rel="noopener"><Icon name="linkedin" />All on LinkedIn</a>
        </p>
      </div>
      <div class="mt-md">
        <Testimonials variant="short" band columns />
      </div>
    </div>
  </section>

  <section id="projects" class="edge-b" aria-labelledby="projects-h">
    <div class="shell grid gap-md py-lg lg:grid-cols-12 lg:gap-lg lg:py-xl">
      <div class="section-head lg:col-span-4 xl:col-span-5">
        <h2 id="projects-h" class="font-display text-h2 tracking-tight">Projects</h2>
        <p class="mt-sm max-w-prose text-muted">Case studies: the problem, what I owned, the decisions and <span class="lv-mark">what changed</span>.</p>
      </div>
      <div class="lg:col-span-8 xl:col-span-7">
        <ul role="list" class="list">
          {featuredProjects.map((entry) => <ProjectRow entry={entry} level="h3" compact />)}
        </ul>
        <p class="mt-md"><a class="hit" href="/projects/">All projects</a></p>
      </div>
    </div>
  </section>

  <section id="writing" class={`band-${WRITING_BAND} edge-b`} data-section="writing" aria-labelledby="writing-h">
    <div class="shell grid gap-md py-lg lg:grid-cols-12 lg:gap-lg">
      <div class="section-head lg:col-span-4 xl:col-span-5">
        <h2 id="writing-h" class="font-display text-h2 tracking-tight">Writing</h2>
        <p class="mt-sm max-w-prose">How I work with AI agents, build front ends and <span class="lv-mark lv-mark--band">keep teams moving</span>.</p>
      </div>
      <div class="lg:col-span-8 xl:col-span-7">
        <ul role="list" class="list">
          {posts.slice(0, 3).map((post, i) => <PostRow post={post} level="h3" featured={i === 0} />)}
          {
            upcoming.map((post) => (
              <li class="flex flex-wrap items-baseline gap-x-md gap-y-xs py-md">
                <h3 class="font-title text-xl">{post.data.title}</h3>
                <p class="label tag">Coming soon</p>
              </li>
            ))
          }
        </ul>
        <p class="mt-sm"><a class="hit" href="/writing/">All writing</a></p>
      </div>
    </div>
  </section>

  <section id="about" class={`band-${ABOUT_BAND}`} aria-labelledby="about-h">
    <div class="shell grid gap-md py-lg lg:grid-cols-12 lg:gap-lg lg:py-xl">
      <h2 id="about-h" class="font-display text-h2 tracking-tight lg:col-span-4 xl:col-span-5">About</h2>
      <div class="lg:col-span-8 xl:col-span-7">
        <p class="max-w-prose text-lg">
          I'm a software engineer from Mexico, now living in Dublin with my wife and daughter. I came to code by way
          of project management and a love of design, and I have been building software for more than 13 years. I
          also can't stop teaching.
        </p>
        <p class="mt-md"><a class="hit hit-primary" href="/about/">More about me</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .name {
    view-transition-name: site-name;
  }
  /* Section headings stay in view while the long list scrolls past (no motion).
     --stick-top (motion.css) keeps them under the sticky header; it is the old offset when the
     header is not sticky. */
  @media (min-width: 64rem) {
    .section-head {
      position: sticky;
      top: var(--stick-top, var(--spacing-md));
      align-self: start;
    }
  }
  /* The hero content stops at the page width. On wider screens the yellow and
     cobalt fills carry on to each edge, so the bands still look full bleed. */
  .hero-inner {
    margin-inline: auto;
    max-width: var(--container-page);
  }
  @media (min-width: 64rem) {
    .hero {
      background: linear-gradient(to right, var(--color-yellow) 50%, var(--color-cobalt) 50%);
    }
  }
  /* Small round headshot above the name: there so people know who they are reading
     about, small enough not to compete with the name. */
  :global(.avatar) {
    display: block;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    border: var(--rule-thick) solid var(--color-black);
    object-fit: cover;
  }
  @media (min-width: 64rem) {
    :global(.avatar) {
      width: 4.5rem;
      height: 4.5rem;
    }
  }
  .hero-aside {
    border-top: var(--rule-thick) solid var(--color-black);
  }
  @media (min-width: 64rem) {
    .hero-aside {
      border-top: 0;
      border-left: var(--rule-thick) solid var(--color-black);
    }
  }
</style>
